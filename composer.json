{
	"name": "eeemarv/eland",
	"license": "AGPL-3.0-only",
	"type": "project",
	"description": "web app for community currencies.",
	"homepage": "https://eland.letsa.net",
	"keywords": ["community", "currencies", "app"],
  "require": {
		"php": "^8.4",
		"ext-ctype": "*",
		"ext-exif": "*",
		"ext-gd": "*",
		"ext-iconv": "*",
		"ext-imagick": "*",
		"ext-intl": "*",
		"ext-mbstring": "*",
		"ext-redis": "*",
		"ext-xml": "*",
		"ext-zip": "*",
		"aws/aws-sdk-php": "^3",
		"bramus/monolog-colored-line-formatter": "~3.1",
		"doctrine/dbal": "^4",
		"doctrine/doctrine-bundle": "^3",
		"doctrine/doctrine-migrations-bundle": "^4",
		"doctrine/orm": "^3",
		"dragonmantank/cron-expression": "^3.4",
		"geo6/geocoder-php-bpost-provider": "^1.4",
		"intervention/image-symfony": "^4.0",
		"league/commonmark": "^2.4",
		"league/flysystem-aws-s3-v3": "*",
		"league/flysystem-bundle": "^3.7",
		"league/html-to-markdown": "^5.1",
		"mollie/mollie-api-php": "^3",
		"monolog/monolog": "^3",
		"nyholm/psr7": "^1.5",
		"ocramius/proxy-manager": "^2.10",
		"php-http/message": "^1.6",
		"psr/http-client": "^1.0",
		"psr/http-factory": "^1.0",
		"snc/redis-bundle": "^4.1",
		"symfony/amazon-mailer": "*",
		"symfony/asset": "*",
		"symfony/asset-mapper": "*",
		"symfony/cache": "*",
		"symfony/config": "*",
		"symfony/console": "*",
		"symfony/contracts": "^3",
		"symfony/debug-bundle": "*",
		"symfony/dotenv": "*",
		"symfony/expression-language": "*",
		"symfony/filesystem": "*",
		"symfony/finder": "*",
		"symfony/flex": "^2",
		"symfony/form": "*",
		"symfony/framework-bundle": "*",
		"symfony/html-sanitizer": "*",
		"symfony/http-client": "*",
		"symfony/lock": "*",
		"symfony/mailer": "*",
		"symfony/messenger": "*",
		"symfony/mime": "*",
		"symfony/monolog-bridge": "*",
		"symfony/monolog-bundle": "^3",
		"symfony/process": "*",
		"symfony/redis-messenger": "*",
		"symfony/runtime": "*",
		"symfony/scheduler": "*",
		"symfony/security-bundle": "*",
		"symfony/security-csrf": "*",
		"symfony/serializer": "*",
		"symfony/stimulus-bundle": "^2.32",
		"symfony/stopwatch": "*",
		"symfony/translation": "*",
		"symfony/twig-bridge": "*",
		"symfony/twig-bundle": "*",
		"symfony/uid": "*",
		"symfony/ux-dropzone": "^2.35",
		"symfony/ux-icons": "^2.31",
		"symfony/ux-twig-component": "^2.31",
		"symfony/validator": "*",
		"symfony/var-dumper": "*",
		"symfony/web-link": "*",
		"symfony/yaml": "*",
		"symfonycasts/sass-bundle": "^0.8.2",
		"twig/cssinliner-extra": "^3.10",
		"twig/extra-bundle": "^3.10",
		"twig/inky-extra": "^3.5",
		"twig/markdown-extra": "^3.5",
		"twig/twig": "^3"
	},

  "require-dev": {
		"symfony/maker-bundle": "^1.62",
		"symfony/phpunit-bridge": "^7.0",
		"symfony/web-profiler-bundle": "7.2.*"
	},

  "config": {
    "preferred-install": {
        "*": "dist"
    },
  "sort-packages": true,
		"allow-plugins": {
			"php-http/discovery": true,
			"symfony/flex": true,
			"symfony/runtime": true
		}
	},

  "minimum-stability": "stable",

	"autoload": {
		"psr-4": {
			"App\\": "src/"
        }
	},

  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
	},

  "replace": {
    "paragonie/random_compat": "2.*",
    "symfony/polyfill-ctype": "*",
    "symfony/polyfill-iconv": "*",
    "symfony/polyfill-php71": "*",
    "symfony/polyfill-php70": "*",
    "symfony/polyfill-php56": "*"
	},

  "scripts": {
    "auto-scripts": {
			"cache:clear": "symfony-cmd",
			"assets:install %PUBLIC_DIR%": "symfony-cmd",
			"importmap:install": "symfony-cmd"
		},
  "post-install-cmd": [
      "@auto-scripts"
    ],
  "post-update-cmd": [
      "@auto-scripts"
    ]
	},

  "conflict": {
    "symfony/symfony": "*"
	},

  "extra": {
    "symfony": {
      "allow-contrib": false,
      "require": "7.4.*"
    }
  }
}
