{%- if transaction.real_to -%}    
  <dd class="bg-warning">
    <div class="clearfix">
      <div class="btn btn-default pull-left me-1">
        <twig:ux:icon name="lucide:share-2"/>
      </div>
      <div>
        <a href="{{- path('users_show', {}|pp(id: transaction.to_user.id)) -}}">
          {{- transaction.to_user.code ?? '***' }}
          {{ (transaction.to_user.remote_schema_active is defined) 
          ? config_str('system.name', transaction.to_user.remote_schema_active) 
          : transaction.to_user.name -}}           
        </a>
      </div>
    </div>
  </dd>
  <dt>
    {{- 'transactions_show.to_remote_account'|trans -}}
  </dt>
  <dd class="bg-warning">
    {%- if transaction.to_user.remote is defined -%}
      <a href="{{- path('users_show',{
        'schema': transaction.to_user.remote_schema,
        'os': schema,
        'role_short': 'g',
        'id': transaction.to_user.remote.user.id,
      }) -}}">
        {{- transaction.to_user.remote.user.code  ?? '***' }}
        {{ transaction.to_user.remote.user.name -}}
      </a>
    {%- else -%}
      {{- transaction.real_to -}}
    {%- endif -%}
  </dd>
{%- else -%}
  {%- set u_class =
    is_new(transaction.to_user) ? ' class="bg-success"' :
    is_leaving(transaction.to_user) ? ' class="bg-danger"' :
    is_intersystem(transaction.to_user) ? ' class="bg-warning"' :
    is_pre_active(transaction.to_user) ? ' class="bg-inactive"' :
    is_post_active(transaction.to_user) ? ' class="bg-info"' : ''
  -%}
  <dd{{- u_class -}}>
    {%- if transaction.to_user.is_active or pp_has_role('admin') -%}
      <a href="{{- path('users_show', {}|pp(id: transaction.to_user.id)) -}}">
        {{- transaction.to_user.code ?? '***' }}
        {{ transaction.to_user.name -}}
      </a>
    {%- else -%}
      {{- transaction.to_user.code ?? '***' }}
      {{ transaction.to_user.name -}}
    {%- endif -%}
  </td>
{%- endif -%}