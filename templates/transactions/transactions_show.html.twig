{%- extends 'transactions/base/transactions_base.html.twig' -%}

{%- block btn_top_edit -%}
  {%- if pp_has_role('admin')
    and (inter_transaction or not is_inter) -%}
    {%- include 'include/btn_top/edit.html.twig' with {
      'btn_route': 'transactions_edit',
      'btn_title': 'transactions_edit.title'
    } -%}
  {%- endif -%}
{%- endblock btn_top_edit -%}

{%- block btn_item_nav -%}
<div class="btn-group ml-5p" role="group">
  <a href="
  {%- if next_id -%}
    {{- path('transactions_show', {}|pp|merge({'id': next_id})) -}}"
  {%- else -%}
  #" disabled
  {%- endif %} class="btn btn-default btn-lg" title="{{- 'nav.next'|trans -}}">
    <twig:ux:icon name="lucide:chevron-up"/>
  </a>

  <a href="
  {%- if prev_id -%}
    {{- path('transactions_show', {}|pp|merge({'id': prev_id})) -}}"
  {%- else -%}
  #" disabled
  {%- endif %} class="btn btn-default btn-lg" title="{{- 'nav.prev'|trans -}}">
    <twig:ux:icon name="lucide:chevron-down"/>
  </a>

  <a href="{{- path('transactions', {}|pp) -}}" class="btn btn-default btn-lg" title="{{- 'nav.list'|trans -}}">
    <twig:ux:icon name="lucide:arrow-left-right"/>
  </a>
</div>
{%- endblock btn_item_nav -%}

{%- block heading_title -%}
    {{- 'transactions_show.title'|trans -}}
{%- endblock heading_title -%}

{%- block css -%}
    {{- parent() -}}
{%- endblock css -%}

{%- block js -%}
    {{- parent() -}}
{%- endblock js -%}