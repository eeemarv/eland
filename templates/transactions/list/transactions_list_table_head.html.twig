{%- set order_by = pag_params.s.order_by -%}
{%- set asc = pag_params.s.asc -%}
{%- set pag = {'start': 0, 'limit':pag_params.p.limit} -%}

{%- if pp_has_role('admin') and bulk_actions_enabled -%}
{# selector column #}
<th data-priority="1">
  &nbsp;
</th>
{%- endif -%}

<th data-priority="1">
  <a href="{{- path('transactions', pag_params|merge({
    's': {
      'order_by': 'description',
      'asc': asc ? '0' : '1',
    },
    'p': pag,
    })|pp) -}}">
    {{- 'label.description'|trans -}}
    &nbsp;
    {%- if order_by != 'description' -%}
      <twig:ux:icon name="lucide:chevrons-up-down" class="text-warning"/>
    {%- elseif asc -%}
      <twig:ux:icon name="lucide:chevron-up"/>
    {%- else -%}
      <twig:ux:icon name="lucide:chevron-down"/>
    {%- endif -%}    
  </a>
</th>

<th data-priority="1">
  <a href="{{- path('transactions', pag_params|merge({
    's': {
      'order_by': 'amount',
      'asc': asc ? '0' : '1',
    },
    'p': pag,
    })|pp) -}}">

    {{- config_str('transactions.currency.name') -}}
    &nbsp;
    {%- if order_by != 'amount' -%}
      <twig:ux:icon name="lucide:chevrons-up-down" class="text-warning"/>
    {%- elseif asc -%}
      <twig:ux:icon name="lucide:chevron-up"/>
    {%- else -%}
      <twig:ux:icon name="lucide:chevron-down"/>
    {%- endif -%}    
  </a>
</th>

<th data-priority="2">
  <a href="{{- path('transactions', pag_params|merge({
    's': {
      'order_by': 'created_at',
      'asc': asc ? '0' : '1',
    },
    'p': pag,
    })|pp) -}}">

    {{- 'label.time'|trans -}}
    &nbsp;
    {%- if order_by != 'created_at' -%}
      <twig:ux:icon name="lucide:chevrons-up-down" class="text-warning"/>
    {%- elseif asc -%}
      <twig:ux:icon name="lucide:chevron-up"/>
    {%- else -%}
      <twig:ux:icon name="lucide:chevron-down"/>
    {%- endif -%}    
  </a>
</th>

{%- if uid -%}

  <th data-priority="3">
    {{- 'label.counterparty'|trans -}}
  </th>

{%- else -%}

  <th data-priority="3">
    <a href="{{- path('transactions', pag_params|merge({
      's': {
        'order_by': 'from_code',
        'asc': asc ? '0' : '1',
      },
      'p': pag,
      })|pp) -}}">
      {{- 'label.from_account'|trans -}}

      &nbsp;
      {%- if order_by != 'from_code' -%}
        <twig:ux:icon name="lucide:chevrons-up-down" class="text-warning"/>
      {%- elseif asc -%}
        <twig:ux:icon name="lucide:chevron-up"/>
      {%- else -%}
        <twig:ux:icon name="lucide:chevron-down"/>
      {%- endif -%}    
    </a>
  </th>

  <th data-priority="3">
    <a href="{{- path('transactions', pag_params|merge({
      's': {
        'order_by': 'to_code',
        'asc': asc ? '0' : '1',
      },
      'p': pag,
      })|pp) -}}">

      {{- 'label.to_account'|trans -}}

      &nbsp;
      {%- if order_by != 'to_code' -%}
        <twig:ux:icon name="lucide:chevrons-up-down" class="text-warning"/>
      {%- elseif asc -%}
        <twig:ux:icon name="lucide:chevron-up"/>
      {%- else -%}
        <twig:ux:icon name="lucide:chevron-down"/>
      {%- endif -%}    
    </a>
  </th>

{%- endif -%}
