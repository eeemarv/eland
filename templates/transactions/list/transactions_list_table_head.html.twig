{%- set order_by = pag_params.s.order_by -%}
{%- set asc = pag_params.s.asc -%}
{%- set pag = {'start': 0, 'limit':pag_params.p.limit} -%}

{%- if pp_has_role('admin') and bulk_actions_enabled -%}
{# selector column #}
<th>
  &nbsp;
</th>
{%- endif -%}

<th>
  <a href="{{- path('transactions', pag_params|merge({
    's': {
      'order_by': 'description',
      'asc': asc ? '0' : '1',
    },
    'p': pag,
    })|pp) -}}">
    {%- if order_by != 'description' -%}
      <twig:ux:icon name="lucide:arrow-down-up"/>
    {%- elseif asc -%}
      <twig:ux:icon name="lucide:arrow-up-a-z"/>
    {%- else -%}
      <twig:ux:icon name="lucide:arrow-down-z-a"/>
    {%- endif -%}
    &nbsp;
    {{- 'label.description'|trans -}}
  </a>
</th>

<th>
  <a href="{{- path('transactions', pag_params|merge({
    's': {
      'order_by': 'amount',
      'asc': asc ? '0' : '1',
    },
    'p': pag,
    })|pp) -}}">
    {%- if order_by != 'amount' -%}
      <twig:ux:icon name="lucide:arrow-down-up"/>
    {%- elseif asc -%}
      <twig:ux:icon name="lucide:arrow-up-0-1"/>
    {%- else -%}
      <twig:ux:icon name="lucide:arrow-down-1-0"/>
    {%- endif -%}
    &nbsp;
    {{- config_str('transactions.currency.name') -}}
  </a>
</th>

<th>
  <a href="{{- path('transactions', pag_params|merge({
    's': {
      'order_by': 'created_at',
      'asc': asc ? '0' : '1',
    },
    'p': pag,
    })|pp) -}}">
    {%- if order_by != 'created_at' -%}
      <twig:ux:icon name="lucide:arrow-down-up"/>
    {%- elseif asc -%}
      <twig:ux:icon name="lucide:arrow-up-0-1"/>
    {%- else -%}
      <twig:ux:icon name="lucide:arrow-down-1-0"/>
    {%- endif -%}
    &nbsp;
    {{- 'label.time'|trans -}}
  </a>
</th>

{%- if uid -%}

  <th data-hide="phone,tablet">
    {{- 'label.counterparty'|trans -}}
  </th>

{%- else -%}

  <th data-hide="phone,tablet">
    <a href="{{- path('transactions', pag_params|merge({
      's': {
        'order_by': 'from_code',
        'asc': asc ? '0' : '1',
      },
      'p': pag,
      })|pp) -}}">
      {%- if order_by != 'from_code' -%}
        <twig:ux:icon name="lucide:arrow-down-up"/>
      {%- elseif asc -%}
        <twig:ux:icon name="lucide:arrow-up-a-z"/>
      {%- else -%}
        <twig:ux:icon name="lucide:arrow-down-z-a"/>
      {%- endif -%}
      &nbsp;
      {{- 'label.from_account'|trans -}}
    </a>
  </th>

  <th data-hide="phone,tablet">
    <a href="{{- path('transactions', pag_params|merge({
      's': {
        'order_by': 'to_code',
        'asc': asc ? '0' : '1',
      },
      'p': pag,
      })|pp) -}}">
      {%- if order_by != 'to_code' -%}
        <twig:ux:icon name="lucide:arrow-down-up"/>
      {%- elseif asc -%}
        <twig:ux:icon name="lucide:arrow-up-a-z"/>
      {%- else -%}
        <twig:ux:icon name="lucide:arrow-down-z-a"/>
      {%- endif -%}
      &nbsp;
      {{- 'label.to_account'|trans -}}
    </a>
  </th>

{%- endif -%}
