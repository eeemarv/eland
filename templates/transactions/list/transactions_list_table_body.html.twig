{%- for tid, t in transactions -%}
	{%- set t_class =
    t.is_canceled ? ' class="inactive"' :
    t.is_expired ? ' class="inactive"' :
    not t.is_confirmed ? ' class="info"' :
    t.real_to or t.real_from or t.remote_ref ? ' class="warning"' :
    ''
  -%}
	<tr{{-t_class|raw-}}>
		{%- if bulk_actions_enabled and pp_has_role('admin') -%}
			<td>
        {%- include 'component/bulk_check_table/checkbox.html.twig' with {
          'id': tid,
        } -%}
			</td>
		{%- endif -%}

		<td>
			<a href="{{- path('transactions_show', {}|pp(id: tid)) -}}">
				<b>
					{{- t.description -}}
				</b>
			</a>
		</td>

		<td>
      {%- if uid -%}
        {%- if uid == t.id_to -%}
          <b class="text-success">
            +{{- t.amount -}}
          </b>
        {%- else -%}
          <b class="text-danger">
            -{{- t.amount -}}
          </b>
        {%- endif -%}
      {%- else -%}
        <b>
			    {{- t.amount -}}
        </b>
      {%- endif -%}
		</td>

		<td>
			{{- t.created_at|format_min -}}
		</td>

    {%- if (uid and uid == t.id_to) or not uid -%}
      {%- include 'transactions/list/transactions_list_td_from.html.twig' -%}
    {%- endif -%}

    {%- if (uid and uid == t.id_from) or not uid -%}
      {%- include 'transactions/list/transactions_list_td_to.html.twig' -%}
    {%- endif -%}

	</tr>
{%- endfor -%}
