{%- include 'component/bulk_check_table/form_start.html.twig' with {
  'form': bulk_service_stuff_form,
} -%}

{{- form_row(bulk_service_stuff_form.service_stuff, {
  'label': false,
}) -}}

<p class="alert alert-warning">
  <b>
  {{- 'transactions.bulk.service_stuff.warning'|trans -}}
  </b>
</p>

{{- form_row(bulk_service_stuff_form.verify, {
  'label': 'check.verify',
}) -}}

{{- form_widget(bulk_service_stuff_form.submit, {
  'label': 'btn.edit',
  'attr': {
    'class': 'btn btn-lg btn-primary',
  },
}) -}}

{{- form_end(bulk_service_stuff_form) -}}