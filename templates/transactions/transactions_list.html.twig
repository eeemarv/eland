{%- extends 'transactions/base/transactions_base.html.twig' -%}

{%- block csv_download_btn -%}
  {%- include 'include/btn_top/csv_download.html.twig' -%}
{%- endblock csv_download_btn -%}

{%- block assets_add -%}
  {{- parent() -}}
  {%- if pp_has_role('admin') -%}
    {{- assets_add(['table_sel.js']) -}}
  {%- endif -%}
  {{- assets_add(['datepicker']) -}}
{%- endblock assets_add -%}

{%- block btn_top_add -%}
  {%- if pp_has_role('admin') or pp_has_role('user') -%}
    {%- if uid and uid != su_id() -%}
      {%- include 'include/btn_top/add.html.twig' with {
        'btn_route': 'transactions_add',
        'btn_route_params': {'tuid': uid},
        'btn_title': 'transactions_add.btn_add_to_user',
        'btn_title_trans_params': {
          'user': account(uid, schema)
        }
      } -%}
    {%- else -%}
      {%- include 'include/btn_top/add.html.twig' with {
        'btn_route': 'transactions_add',
        'btn_title': 'transactions_add.title'
      } -%}
    {%- endif -%}
  {%- endif -%}
{%- endblock btn_top_add -%}

{%- block btn_top_bulk -%}
  {%- if pp_has_role('admin') and bulk_actions_enabled -%}
    {%- include 'include/btn_top/bulk.html.twig' -%}
  {%- endif -%}
{%- endblock btn_top_bulk -%}

{%- block heading_title -%}
  {{- 'transactions.title'|trans({
    'self': is_self ? 'self' : (uid ? 'some_user' : 'all'),
    'account': uid ? account(uid)|link('users_show', {'id': uid})
  })|raw -}}
{%- endblock heading_title -%}

{%- block heading_append -%}
  {%- include 'include/filter/heading_filter.html.twig' -%}
  {%- include 'include/filter/heading_btn_filter.html.twig' -%}
{%- endblock heading_append -%}

{%- block heading_sub -%}
  {%- if uid -%}
  <h2>
    {{- 'label.current_balance'|trans -}}:
    <span class="label label-info">
      {{- account_balance(uid, schema) -}}
    </span>
    &nbsp;
    {{- config_str('transactions.currency.name', schema) -}}
  </h2>
  {%- endif -%}
{%- endblock heading_sub -%}

{%- block filter_form_a -%}
  {%- include 'transactions/include/transactions_filter_form.html.twig' -%}
{%- endblock filter_form_a -%}

{%- block pagination -%}
  {%- include 'include/pagination/pagination.html.twig' -%}
{%- endblock pagination -%}

{%- block content -%}{%- endblock -%}

{%- block data -%}
  {%- if row_count -%}
    {%- include 'transactions/list/transactions_list_table.html.twig' -%}
  {%- else -%}
    {%- include 'include/no_results.html.twig' -%}
  {%- endif -%}
{%- endblock data -%}

{%- block footnote -%}
  {%- include 'transactions/list/transactions_list_stats.html.twig' -%}
{%- endblock footnote -%}

{%- block bulk_actions -%}
  {%- if pp_has_role('admin') and bulk_actions_enabled -%}
    {%- include 'transactions/list/transactions_list_bulk.html.twig' -%}
  {%- endif -%}
{%- endblock bulk_actions -%}

{%- block css -%}
  {{- parent() -}}
{%- endblock css -%}

{%- block js -%}
  {{- parent() -}}
{%- endblock js -%}
