data-action="datatable:draw->mass-count#calculate
datatable:draw->user-count-table#calculate"
{%- endblock content_controllers_attr -%}

{%- block heading_title -%}
  {{- 'transactions_mass.title'|trans -}}
{%- endblock heading_title -%}

{%- block heading_sub -%}
  {%- include 'transactions/mass/transactions_mass_menu.html.twig' -%}
{%- endblock heading_sub -%}

{%- block help_form -%}
