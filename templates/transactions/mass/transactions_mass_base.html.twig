{%- endblock help_form -%}

{%- block filter_form_a -%}
  {%- include 'form/q_filter.html.twig' -%}
{%- endblock filter_form_a -%}

{%- block pane_select -%}
  {%- include 'transactions/mass/transactions_mass_nav_tabs.html.twig' -%}
{%- endblock pane_select -%}

{%- block form_b -%}
  {%- include 'transactions/mass/transactions_mass_table.html.twig' -%}
{%- endblock form_b -%}

{%- block form_d -%}
  {%- include 'transactions/mass/transactions_mass_d.html.twig' -%}
