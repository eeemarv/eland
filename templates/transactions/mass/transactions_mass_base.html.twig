{%- extends 'transactions/base/transactions_base.html.twig' -%}

{%- block content -%}{%- endblock content -%}

{%- set admin_heading = true -%}
{%- set active_local_admin_menu = 'mass_transaction' -%}
{%- set cancel_route = 'transactions' -%}

{%- block content_controllers -%}
datatable
user-count-table
mass-fill
mass-count
{%- endblock content_controllers -%}

