<div class="bg-white">
  <table class="table table-bordered table-striped table-hover"
    data-mass-count-target="table"
  >
    <thead>
      <tr>
        {%- include 'transactions/mass/transactions_mass_table_head.html.twig' -%}
      </tr>
    </thead>
    <tbody>
      {%- include 'transactions/mass/transactions_mass_table_body.html.twig' -%}
    </tbody>
    <tfoot>
      <td colspan="4">
        {{- 'label.total'|trans }}:
        <b>
          <span data-mass-count-target="totalAmount">
          0
          </span>
          &nbsp;
          {{- config_str('transactions.currency.name') -}}
        </b>
        {{ 'transactions_mass.number_transactions'|trans }}:
        <b><span data-mass-count-target="rowCount">0</span></b>
      </td>
    </tfoot>
  </table>
</div>
