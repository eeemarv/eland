{%- extends 'register_form/base/register_form_base.html.twig' -%}

{%- block content -%}

  <div class="panel panel-success">
    {% if 'link_sent' in app.flashes('content') %}
      <div class="panel-heading">
        <h3>
          {{- 'register_form_link_sent.flash.link_sent'|trans -}}
        </h3>
      </div>
    {%- endif -%}
    <div class="panel-body">
      <a href="{{- path('home', {}|pp) -}}" class="btn btn-lg btn-primary">
        {{- 'btn.back_to_home'|trans -}}
      </a>
    </div>
  </div>

{%- endblock content -%}
