{%- extends 'register_form/base/register_form_base.html.twig' -%}


{%- block content -%}
	<div class="panel panel-{%- if success -%}success{%- else -%}danger{%- endif -%}">
		<div class="panel-heading">
			<h3>
        {%- if success -%}
				  {{- 'register_form_confirm.success'|trans -}}
        {%- elseif is_already_confirmed -%}
				  {{- 'register_form_confirm.already_confirmed'|trans({
            'confirmed_at': confirmed_at|date_format('min')
          }) -}}
        {%- elseif is_expired -%}
				  {{- 'register_form_confirm.expired'|trans -}}
        {%- elseif is_not_found -%}
				  {{- 'register_form_confirm.not_found'|trans -}}
        {%- endif -%}
			</h3>
		</div>

		<div class="panel-body">
			<a href="{{- path('home', {}|pp) -}}" class="btn btn-lg btn-primary">
				{{- 'btn.back_to_home'|trans -}}
			</a>

      {%- if not success and not is_already_confirmed -%}
        &nbsp;
        <a href="{{- path('register_form', {}|pp) -}}" class="btn btn-lg btn-primary">
          {{- 'btn.try_again'|trans -}}
        </a>
      {%- endif -%}
		</div>
	</div>

{%- endblock content -%}
