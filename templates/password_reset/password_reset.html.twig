{%- extends 'password_reset/base/password_reset_base.html.twig' -%}

{%- block heading_title -%}
  {{- 'password_reset.title'|trans -}}
{%- endblock heading_title -%}

{%- block content -%}
  {% if 'open_email' in app.flashes('content') %}

    <div class="panel panel-success">
      <div class="panel-heading">
        <h3>
          {{- 'password_reset.flash.open_email_confirm_link'|trans -}}
        </h3>
      </div>
      <div class="panel-body">
        <a href="{{- path('login', {}|pp) -}}" class="btn btn-lg btn-primary">
          {{- 'btn.back_to_login'|trans -}}
        </a>
      </div>
    </div>

  {%- endif -%}

{%- endblock content -%}

{%- block form_a -%}
  {{- form_row(form.email, {
    'label': 'label.your_email',
    'help': 'password_reset.email.help',
    'pre_addon': {
      'fa': 'envelope-o'
    }
  }) -}}
{%- endblock form_a -%}

{%- block form_cancel_btn -%}
{%- endblock form_cancel_btn -%}

{%- block form_submit_btn -%}
  {%- include 'form/submit_send_btn.html.twig' with {
    'label': 'password_reset.btn'
  } -%}
{%- endblock form_submit_btn -%}

{%- block css -%}
  {{- parent() -}}
{%- endblock css -%}

{%- block js -%}
  {{- parent() -}}
{%- endblock js -%}