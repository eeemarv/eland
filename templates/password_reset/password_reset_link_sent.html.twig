{%- extends 'password_reset/base/password_reset_base.html.twig' -%}

{%- block heading_title -%}
  {{- 'password_reset.title'|trans -}}
{%- endblock heading_title -%}

{%- block content -%}

    <div class="panel panel-success">

      {% if 'link_sent' in app.flashes('content') %}
      <div class="panel-heading">
        <h3>
          {{- 'password_reset_link_sent.flash.open_email_confirm_link'|trans -}}
        </h3>
      </div>
      {%- endif -%}

      <div class="panel-body">
        <a href="{{- path('login', {}|pp) -}}" class="btn btn-lg btn-primary">
          {{- 'btn.back_to_login'|trans -}}
        </a>
      </div>
    </div>

{%- endblock content -%}

{%- block css -%}
  {{- parent() -}}
{%- endblock css -%}

{%- block js -%}
  {{- parent() -}}
{%- endblock js -%}