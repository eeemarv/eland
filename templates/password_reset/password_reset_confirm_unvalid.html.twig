{%- extends 'password_reset/base/password_reset_base.html.twig' -%}

{%- block assets_add -%}
  {{- parent() -}}
{%- endblock assets_add -%}

{%- block heading_title -%}
  {{- 'password_reset_confirm.title'|trans -}}
{%- endblock heading_title -%}

{%- block content -%}

	<div class="panel panel-danger">
		<div class="panel-heading">
			<h3>
        {%- if is_already_confirmed -%}
				  {{- 'password_reset_confirm_unvalid.already_confirmed'|trans({
            'confirmed_at': confirmed_at|date_format('min')
          }) -}}
        {%- elseif is_expired -%}
				  {{- 'password_reset_confirm_unvalid.expired'|trans -}}
        {%- elseif is_not_found -%}
				  {{- 'password_reset_confirm_unvalid.not_found'|trans -}}
        {%- endif -%}
			</h3>
		</div>

		<div class="panel-body">
			<a href="{{- path('login', {}|pp) -}}" class="btn btn-lg btn-primary">
				{{- 'btn.back_to_login'|trans -}}
			</a>
      &nbsp;
      <a href="{{- path('password_reset', {}|pp) -}}" class="btn btn-lg btn-primary">
        {{- 'btn.try_again'|trans -}}
      </a>
		</div>
	</div>
{%- endblock content -%}

{%- block js -%}
  {{- parent() -}}
{%- endblock js -%}