{%- extends 'base/navbar.html.twig' -%}

{%- set active_menu = 'support_form' -%}

{%- block content -%}

  {% if 'sent' in app.flashes('content') %}
    <div class="panel panel-success">
      <div class="panel-heading">
        <h3>
          {{- 'support_form.flash.sent'|trans({
            'system_name': config_str('system.name')
          }) -}}
        </h3>
      </div>
    </div>
  {%- endif -%}

{%- endblock content -%}
