{%- extends 'base/navbar.html.twig' -%}

{%- set active_menu = 'logs' -%}

{%- set admin_heading = true -%}

{%- block content_controllers -%}
csv
{%- endblock content_controllers -%}

{%- block content_controllers_attr -%}
data-csv-filename-value="logs"
{%- endblock content_controllers_attr -%}

{%- block csv_download_btn -%}
  {%- include 'include/btn_top/csv_download.html.twig' -%}
{%- endblock csv_download_btn -%}

{%- block heading_icon -%}
<twig:ux:icon name="lucide:history"/>
{%- endblock heading_icon -%}

{%- block heading_title -%}
  {{- 'logs.title'|trans -}}
{%- endblock heading_title -%}

{%- block filter_form_a -%}
  {%- include 'logs/list/logs_list_filter_form.html.twig' -%}
{%- endblock filter_form_a -%}

{%- block pagination -%}
  {%- include 'include/pagination/pagination.html.twig' -%}
{%- endblock pagination -%}

{%- block content -%}{%- endblock -%}

{%- block data -%}
  {%- if row_count -%}
    {%- include 'logs/list/logs_list_table.html.twig' -%}
  {%- else -%}
    {%- include 'include/no_results.html.twig' -%}
  {%- endif -%}
{%- endblock data -%}
