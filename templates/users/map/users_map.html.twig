

<div class="panel panel-default">
  <div class="panel-body">
    <div class="users-map"
      data-controller="map"
      data-map-token-value="{{- env_map_access_token -}}"
      data-map-tiles-url-value="{{- env_map_tiles_url -}}"
      data-map-markers-value="{{- map_markers|default([])|json_encode -}}"
      data-map-icon-value="{{ ux_icon('lucide:map-pin', {class: 'w-100 h-100'})|e('html_attr') }}"
      data-map-bg-icon-value="{{ ux_icon('heroicons:map-pin-20-solid', {class: 'w-100 h-100'})|e('html_attr') }}"
    >
    </div>
  </div>
  <div class="panel-footer">
    {%- if hidden_ary -%}
      <h4>
        {{- 'users_map.hidden.title'|trans -}}
      </h4>
      <p>
        {{- 'users_map.hidden.users'|trans -}}:
      </p>
      <ul>
        {%- for uid, count in hidden_ary -%}
          <li>
            <a href="{{- path('users_show', {'id':uid}|pp) -}}">
              {{- users[uid].username -}}
            </a>
            {%- if count > 1 -%}
              &nbsp;
              ({{- count -}})
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
    {%- if no_address_ary -%}
      <h4>
        {{- 'users_map.no_address.title'|trans -}}
      </h4>
      <p>
        {{- 'users_map.no_address.users'|trans -}}:
      </p>
      <ul>
        {%- for uid in no_address_ary -%}
          <li>
            <a href="{{- path('users_show', {'id':uid}|pp) -}}">
              {{- users[uid].username -}}
            </a>
          </li>
        {%- endfor -%}
      </ul>

    {%- endif -%}
    {%- if not_geocoded_ary -%}
      <h4>
        {{- 'users_map.not_geocoded.title'|trans -}}
      </h4>
      <p>
        {{- 'users_map.not_geocoded.explain'|trans -}}
      </p>
      <p>
        {{- 'users_map.not_geocoded.users'|trans -}}:
      </p>
      <ul>
        {%- for uid, count in not_geocoded_ary -%}
          <li>
            <a href="{{- path('users_show', {'id':uid}|pp) -}}">
              {{- users[uid].username -}}
            </a>
            {%- if count > 1 -%}
              &nbsp;
              ({{- count -}})
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>
