{%- if pp_has_role('admin') -%}
{%- embed 'embed/list_item.html.twig' -%}
  {%- block class -%}
    list-group-item-info
  {%- endblock class -%}
  {%- block dl -%}
    <dt>
      {{- 'label.transaction_account'|trans -}}
    </dt>
    <dd>
      {{- 'users_account.no_account_yet'|trans -}}
    </dd>
  {%- endblock dl -%}
  {%- block div_right -%}
    <a href="{{- path('users_account_code_add' ~ (is_self ? '_self' : ''), (is_self ? {} : {'id': id})|pp) -}}"
      class="btn btn-success"
      title="{{- 'users_account_code_edit.title'|trans({
            'user': user.name,
            'self': is_self ? 'yes' : 'no',
            'mode': 'add',
          }) -}}">
      <twig:ux:icon name="lucide:circle-plus"/>
      &nbsp;
      <span class="hidden-sm">
        {{- 'btn.add'|trans -}}
      </span>
    </a>
  {%- endblock div_right -%}
{%- endembed -%}
{%- endif -%}
