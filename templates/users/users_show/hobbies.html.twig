{%- if not is_intersystem and config_bool('users.fields.hobbies.enabled', schema) -%}
{%- embed 'embed/list_item.html.twig' -%}
  {%- import 'macro/lbl.html.twig' as l -%}
  {%- block dl -%}
    <dt>
      {{- 'label.hobbies_interests'|trans -}}
    </dt>
    <dd>
      {%- if user.hobbies is empty -%}
        <twig:ux:icon name="lucide:x" class="text-bold"/>
      {%- else -%}
        {{- user.hobbies -}}
      {%- endif -%}
    </dd>
  {%- endblock dl -%}
  {%- block div_right -%}
    {%- if pp_has_role('admin') or is_self -%}

      <a href="{{- path('users_hobbies_edit' ~ (is_self ? '_self' : ''), (is_self ? {} : {'id': id})|pp) -}}"
        class="btn btn-primary"
        title="{{- 'users_hobbies_edit.title'|trans({
          'user': user.name,
          'self': is_self ? 'yes' : 'no',
        }) -}}">
        <twig:ux:icon name="lucide:pencil"/>
        &nbsp;
        <span class="hidden-sm">
          {{- 'btn.edit'|trans -}}
        </span>
      </a>

    {%- endif -%}
  {%- endblock div_right -%}
{%- endembed -%}
{%- endif -%}
