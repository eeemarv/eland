{%- extends 'users/base/users_overview.html.twig' -%}

{%- block assets_add -%}
  {{- parent() -}}
  {{- assets_add(['isotope', 'users_tiles.js']) -}}
{%- endblock assets_add -%}

{%- block filter_form_a -%}
  {%- include 'form/q_filter.html.twig' -%}
{%- endblock filter_form_a -%}

{%- block pane_select -%}
  {%- include 'users/list/users_nav_tabs.html.twig' -%}
{%- endblock pane_select -%}

{%- block content -%}{%- endblock -%}

{%- block data -%}
  {%- if users|length -%}
    {%- include 'users/tiles/users_tiles.html.twig' -%}
  {%- else -%}
    {%- include 'include/no_results.html.twig' -%}
  {%- endif -%}
{%- endblock data -%}

{%- block css -%}
  {{- parent() -}}
{%- endblock css -%}

{%- block js -%}
  {{- parent() -}}
{%- endblock js -%}