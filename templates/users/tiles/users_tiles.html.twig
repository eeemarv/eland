{%- set postcode_enabled = config_bool('users.fields.postcode.enabled') -%}

<p>
  <span class="btn-group sort-by" role="group">
    <button class="btn btn-default active" data-sort-by="code">
      {{- 'label.account_code'|trans -}}
      &nbsp;
      <twig:ux:icon name="lucide:arrow-down-up"/>
    </button>
    <button class="btn btn-default" data-sort-by="name">
      {{ 'label.name'|trans -}}
      &nbsp;
      <twig:ux:icon name="lucide:arrow-down-up"/>
    </button>
    {%- if postcode_enabled -%}
      <button class="btn btn-default" data-sort-by="postcode">
        {{- 'label.postcode'|trans -}}
        &nbsp;
        <twig:ux:icon name="lucide:arrow-down-up"/>
      </button>
    {%- endif -%}
  </span>
</p>

<div class="row tiles">
{%- for uid, u in users -%}
  {%- set u_class =
    is_new(u) ? ' class="bg-success"' :
    is_leaving(u) ? ' class="bg-danger"' :
    is_active(u) ? '' :
    is_inactive(u) ? ' class="bg-inactive"' :
    is_ip(u) ? ' class="bg-warning"' :
    is_im(u) ? ' class="bg-info"' :
    is_extern(u) ? ' class="bg-extern"' : ''
  -%}
  {%- set can_link = is_active(uid) or pp_has_role('admin') -%}
  {%- set u_link = can_link ? path('users_show', {'id': uid, 'status': all_params.status}|pp) : null -%}
  <div class="col-xs-4 col-md-3 col-lg-2 tile">
    <div{{- u_class|raw -}}>
      <div class="thumbnail text-center">
        {%- if can_link -%}
        <a href="{{- u_link -}}">
        {%- endif -%}
        {%- if u.image_file -%}
          <img src="{{- s3(u.image_file) -}}" class="img-rounded" alt="{{- u.name -}}">
        {%- else -%}
          <div>
            <i class="fa fa-user fa-5x text-muted"></i>
          </div>
        {%- endif -%}
        {%- if can_link -%}
        </a>
        {%- endif -%}
        <div class="caption">
          {%- if can_link -%}
            <a href="{{- u_link -}}">
              <span class="code">{{- u.code -}}</span>
              <span class="name">{{- u.name -}}</span>
            </a>
          {%- else -%}
            <span class="code">{{- u.code -}}</span>
            <span class="name">{{- u.name -}}</span>
          {%- endif -%}
          {%- if postcode_enabled -%}
            <br>
            <span class="postcode">
              {{- u.postcode -}}
            </span>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
{%- endfor -%}
</div>
