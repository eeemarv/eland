{%- extends 'users/base/users_single_form.html.twig' -%}

{%- block heading_title -%}
  {{- 'users_name_edit.title'|trans({
    'self': is_self ? 'yes' : 'no',
    'user': account(id, schema),
  }) -}}
{%- endblock heading_title -%}

{%- block form_a -%}
  {{- form_row(form.name, {
    'label': 'label.username',
    'addon': ux_icon('lucide:user'),
  }) -}}
{%- endblock form_a -%}
