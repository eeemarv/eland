
{%- include 'component/bulkchecktable/form_start.html.twig' with {
  'form': bulk_periodic_overview_en_form,
} -%}

{{- form_row(bulk_periodic_overview_en_form.periodic_overview_en, {
  'label': 'label.periodic_overview_en',
}) -}}

<p class="alert alert-warning">
  <b>
  {{- 'users_list.bulk.periodic_overview_en.warning'|trans -}}
  </b>
</p>

{{- form_row(bulk_periodic_overview_en_form.verify, {
  'label': 'check.verify',
}) -}}

{{- form_widget(bulk_periodic_overview_en_form.submit, {
  'label': 'btn.edit',
  'attr': {
    'class': 'btn btn-lg btn-primary',
  },
}) -}}

{{- form_end(bulk_periodic_overview_en_form) -}}