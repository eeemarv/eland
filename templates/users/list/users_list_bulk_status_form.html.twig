{{- form_start(bulk_status_form, {'attr': {'novalidate': 'novalidate'}}) -}}
{{- form_errors(bulk_status_form) -}}

{{- form_widget(bulk_status_form.selected) -}}

{{- form_row(bulk_status_form.status, {
  'label': false,
  'addon': ux_icon('lucide:star'),
}) -}}

<p class="alert alert-warning">
  <b>
  {{- 'users_list.bulk.status.warning'|trans -}}
  </b>
</p>

{{- form_row(bulk_status_form.verify, {
  'label': 'check.verify',
}) -}}

{{- form_widget(bulk_status_form.submit, {
  'label': 'btn.edit',
  'attr': {
    'class': 'btn btn-lg btn-primary',
  },
}) -}}

{{- form_end(bulk_status_form) -}}