
{%- include 'component/bulkchecktable/form_start.html.twig' with {
  'form': bulk_leaving_form,
} -%}

{{- form_row(bulk_leaving_form.is_leaving, {
  'label': 'label.admin_comments',
}) -}}

<div data-controller="checkbox-follow">
{{- form_row(bulk_leaving_form.send_email, {
  'label': 'users.list.bulk.send_email',
  'attr': {
    'data-checkbox-follow-target': 'trigger',
    'data-action': 'change->checkbox-follow#toggle'
  }
}) -}}

{{- form_row(bulk_leaving_form.send_email_cc, {
  'label': 'users.list.bulk.send_email_cc',
  'attr': {
    'data-checkbox-folow-target': 'dependent',
  },
  'disabled': true,
}) -}}
</div>

{%- include 'form/log_comment.html.twig' with {
  'form': bulk_leaving_form,
  'inline': false,
} -%}

{{- form_row(bulk_leaving_form.verify, {
  'label': 'check.verify',
}) -}}

{{- form_widget(bulk_leaving_form.submit, {
  'label': 'btn.edit',
  'attr': {
    'class': 'btn btn-lg btn-primary',
  },
}) -}}

{{- form_end(bulk_leaving_form) -}}