
{%- include 'component/bulk_check_table/form_start.html.twig' with {
  'form': bulk_full_name_access_form,
} -%}

{{- form_row(bulk_full_name_access_form.access, {
  'label': 'label.visibility',
}) -}}

<p class="alert alert-warning">
  <b>
  {{- 'users_list.bulk.full_name_access.warning'|trans -}}
  </b>
</p>

{{- form_row(bulk_full_name_access_form.verify, {
  'label': 'check.verify',
}) -}}

{{- form_widget(bulk_full_name_access_form.submit, {
  'label': 'btn.edit',
  'attr': {
    'class': 'btn btn-lg btn-primary',
  },
}) -}}

{{- form_end(bulk_full_name_access_form) -}}