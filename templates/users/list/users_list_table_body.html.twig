{%- for uid, u in users -%}
  {%- set u_class =
    is_new(u) ? ' class="success"' :
    is_leaving(u) ? ' class="danger"' :
    is_active(u) ? '' :
    is_inactive(u) ? ' class="inactive"' :
    is_ip(u) ? ' class="warning"' :
    is_im(u) ? ' class="info"' :
    is_extern(u) ? ' class="extern"' : ''
  -%}
  {%- set can_link = is_active(uid) or pp_has_role('admin') -%}
  {%- set u_link = can_link ? path('users_show', {'id': uid, 'status': all_params.status}|pp) : null -%}
  {%- set u_code = (u.code ?? '') ~ ' ' ~ (u.name ?? '') -%}
  <tr{{- u_class|raw }} data-balance="{{- balance_ary[uid] ?? '0' -}}">

    {%- if pp_has_role('admin') -%}
    <td>
      {%- include 'component/bulkchecktable/checkbox.html.twig' with {
        'id': uid,
      } -%}
    </td>
    {%- endif -%}

    {%- if cols.code -%}
    <td>
      {%- if can_link -%}
      <a href="{{- u_link -}}">
        {{- u.code ?? '***' -}}
      </a>
      {%- else -%}
        {{- u.code ?? '***' -}}
      {%- endif -%}
    </td>
    {%- endif -%}

    {%- if cols.name -%}
    <td>
      {%- if can_link -%}
      <a href="{{- u_link -}}">
        {{- u.name ?? '***' -}}
      </a>
      {%- else -%}
        {{- u.name ?? '***' -}}
      {%- endif -%}
    </td>
    {%- endif -%}

    {%- if cols.full_name -%}
    <td>
      {%- if can_link -%}
      <a href="{{- u_link -}}">
        {{- u.full_name ?? '***' -}}
      </a>
      {%- else -%}
        {{- u.full_name ?? '***' -}}
      {%- endif -%}
    </td>
    {%- endif -%}

    {%- if cols.postcode -%}
    <td>
      {{- u.postcode ?? '/' -}}
    </td>
    {%- endif -%}

    {%- if cols.role -%}
    <td>
      {%- if u.role == 'admin' -%}
        <span class="btn btn-info">
          {{- 'role.admin'|trans -}}
        </span>
      {%- elseif u.role == 'user' -%}
        <span class="btn btn-default">
          {{- 'role.user'|trans -}}
        </span>
      {%- elseif u.role == 'guest' -%}
        <span class="btn btn-warning">
          {{- 'role.guest'|trans -}}
        </span>
      {%- else -%}
         {{- u.role ?? '/' -}}
      {%- endif -%}
    </td>
    {%- endif -%}

    {%- if cols.balance -%}
    <td>
      {{- balance_ary[uid] ?? '0' -}}
    </td>
    {%- endif -%}

    {%- if cols.balance_on_date and cols.balance_date -%}
    <td>
      {{- balance_on_date_ary[uid] ?? '0' -}}
    </td>
    {%- endif -%}

    {%- if cols.min_limit -%}
    <td>
      {{- min_limit_ary[uid] ?? '' -}}
    </td>
    {%- endif -%}

    {%- if cols.max_limit -%}
    <td>
      {{- max_limit_ary[uid] ?? '' -}}
    </td>
    {%- endif -%}

    {%- if cols.comments -%}
    <td>
      {{- u.comments ?? '***' -}}
    </td>
    {%- endif -%}

    {%- if cols.hobbies -%}
    <td>
      {{- u.hobbies ?? '' -}}
    </td>
    {%- endif -%}

    {%- if cols.birthdate -%}
      {%- if u.birthdate -%}
        <td data-order="{{- u.birthdate|date('U') -}}">
          {{- u.birthdate|date_format('day') -}}
        </td>
      {%- else -%}
        <td>/</td>
      {%- endif -%}
    {%- endif -%}

    {%- if cols.admin_comments -%}
    <td>
      {{- u.admin_comments ?? '' -}}
    </td>
    {%- endif -%}

    {%- if cols.periodic_overview -%}
    <td>
      {%- if u.periodic_overview_en -%}
        <span class="btn btn-success">
          {{- 'label.on'|trans -}}
        </span>
      {%- else -%}
        <span class="btn btn-danger">
          {{- 'label.off'|trans -}}
        </span>
      {%- endif -%}
    </td>
    {%- endif -%}

    {%- if cols.created_at -%}
      <td data-order="{{- u.created_at|date('U') -}}">
        {{- u.created_at|date_format('day') -}}
      </td>
    {%- endif -%}

    {%- if cols.last_edit_at -%}
      <td data-order="{{- u.last_edit_at|date('U') -}}">
        {{- u.last_edit_at|date_format('day') -}}
      </td>
    {%- endif -%}

    {%- if cols.activated_at -%}
      {%- if u.adate -%}
        <td data-order="{{- u.adate|date('U') -}}">
          {{- u.adate|date_format('day') -}}
        </td>
      {%- else -%}
        <td>/</td>
      {%- endif -%}
    {%- endif -%}

    {%- if cols.last_login_at -%}
      {%- if last_login_ary[uid] is defined -%}
        <td data-order="{{- last_login_ary[uid]|date('U') -}}">
          {{- last_login_ary[uid]|date_format('day') -}}
        </td>
      {%- else -%}
        <td>/</td>
      {%- endif -%}
    {%- endif -%}

    {%- for abbrev, b in cols.contacts -%}
    {%- if b -%}
      <td>
      {%- if contacts_ary[uid][abbrev] is defined -%}
        {%- for c in contacts_ary[uid][abbrev] -%}
          {%- if c.access|is_visible -%}
            {{- c.value -}}
          {%- else -%}
            <span class="btn btn-default">
              {{- 'label.hidden'|trans -}}
            </span>
          {%- endif -%}
          {%- if not loop.last -%}
            <br>
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
          /
      {%- endif -%}
      </td>
    {%- endif -%}
    {%- endfor -%}

    {%- if cols.distance -%}
      {%- if distance_ary[uid].is_hidden is defined and distance_ary[uid].is_hidden -%}
        <td data-order="5000000">
          <span class="btn btn-default">
            {{- 'label.hidden'|trans -}}
          </span>
        </td>
      {%- else -%}
        <td data-order="5000000"{%- if distance_ary[uid].lat is defined %} data-lat="{{- distance_ary[uid].lat -}}" data-lng="{{- distance_ary[uid].lng -}}"
        {%- if su_id() == uid %} data-distance-self{%- endif -%}
        {%- endif -%}>
          <twig:ux:icon name="lucide:x"/>
        </td>
      {%- endif -%}
    {%- endif -%}

    {%- if cols.mollie -%}
    <td>
      {%- if mollie_ary[uid] is not defined -%}
        &nbsp;
      {%- elseif mollie_ary[uid].is_paid -%}
      <span class="label label-success"
        title="{{- mollie_ary[uid].description -}}&#10;
        {{- mollie_ary[uid].amount|replace({'.': ','}) }} EUR&#10;
        @ {{ mollie_ary[uid].paid_at|date_format('day') -}}"
      >
        {{- 'mollie.status.paid'|trans -}}
      </span>
      {%- elseif mollie_ary[uid].is_canceled -%}
      <span class="label label-default"
        title="{{- mollie_ary[uid].description -}}&#10;
        {{- mollie_ary[uid].amount|replace({'.': ','}) }} EUR&#10;
        @ {{ mollie_ary[uid].canceled_at|date_format('day') -}}"
      >
        {{- 'mollie.status.canceled'|trans -}}
      </span>
      {%- else -%}
      <span class="label label-warning"
        title="{{- mollie_ary[uid].description -}}&#10;
        {{- mollie_ary[uid].amount|replace({'.': ','}) }} EUR&#10;
        @ {{ mollie_ary[uid].created_at|date_format('day') -}}"
      >
        {{- 'mollie.status.open'|trans -}}
      </span>
      {%- endif -%}
    </td>
    {%- endif -%}

    {%- if cols.wants -%}
      {%- if messages_ary[uid] is defined -%}
        <td data-order="{{- messages_ary[uid].wants -}}">
          <a href="{{- path('messages'|var_route, {
            'uid': uid,
            'f':{
              'user': u_code,
              'ow': ['want'],
            }}|pp) -}}">
            {{- messages_ary[uid].wants -}}
          </a>
        </td>
      {%- else -%}
        <td>0</td>
      {%- endif -%}
    {%- endif -%}

    {%- if cols.offers -%}
      {%- if messages_ary[uid] is defined -%}
        <td data-order="{{- messages_ary[uid].offers -}}">
          <a href="{{- path('messages'|var_route, {
            'uid': uid,
            'f':{
              'user': u_code,
              'ow': ['offer'],
            }}|pp) -}}">
            {{- messages_ary[uid].offers -}}
          </a>
        </td>
      {%- else -%}
        <td>0</td>
      {%- endif -%}
    {%- endif -%}

    {%- if cols.offers_and_wants -%}
      {%- if messages_ary[uid] is defined -%}
        <td data-order="{{- messages_ary[uid].total -}}">
          <a href="{{- path('messages'|var_route, {
            'uid': uid,
            'f':{
              'user': u_code,
              'ow': ['offer', 'want'],
            }}|pp) -}}">
            {{- messages_ary[uid].total -}}
          </a>
        </td>
      {%- else -%}
        <td>0</td>
      {%- endif -%}
    {%- endif -%}

    {%- if cols.transactions_in -%}
      {%- if trans_ary[uid] is defined -%}
        <td data-order="{{- trans_ary[uid].trans_in -}}">
          <a href="{{- path('transactions', {
            'uid': uid,
            'f':{
              'to_account': u_code,
              'from_date': transactions_from_date|date_format('day'),
            }}|pp) -}}">
            {{- trans_ary[uid].trans_in -}}
          </a>
        </td>
      {%- else -%}
        <td>0</td>
      {%- endif -%}
    {%- endif -%}

    {%- if cols.transactions_out -%}
      {%- if trans_ary[uid] is defined -%}
        <td data-order="{{- trans_ary[uid].trans_out -}}">
          <a href="{{- path('transactions', {
            'uid': uid,
            'f':{
              'from_account': u_code,
              'from_date': transactions_from_date|date_format('day'),
            }}|pp) -}}">
            {{- trans_ary[uid].trans_out -}}
          </a>
        </td>
      {%- else -%}
        <td>0</td>
      {%- endif -%}
    {%- endif -%}

    {%- if cols.transactions_total -%}
      {%- if trans_ary[uid] is defined -%}
        <td data-order="{{- trans_ary[uid].trans_total -}}">
          <a href="{{- path('transactions', {
            'uid': uid,
            'f':{
              'account_logic': 'or',
              'to_account': u_code,
              'from_account': u_code,
              'from_date': transactions_from_date|date_format('day'),
            }}|pp) -}}">
            {{- trans_ary[uid].trans_total -}}
          </a>
        </td>
      {%- else -%}
        <td>0</td>
      {%- endif -%}
    {%- endif -%}

    {%- if cols.amount_in -%}
      {%- if trans_ary[uid] is defined -%}
        <td data-order="{{- trans_ary[uid].amount_in -}}">
          <a href="{{- path('transactions', {
            'uid': uid,
            'f':{
              'to_account': u_code,
              'from_date': transactions_from_date|date_format('day'),
            }}|pp) -}}">
            {{- trans_ary[uid].amount_in -}}
          </a>
        </td>
      {%- else -%}
        <td>0</td>
      {%- endif -%}
    {%- endif -%}

    {%- if cols.amount_out -%}
      {%- if trans_ary[uid] is defined -%}
        <td data-order="{{- trans_ary[uid].amount_out -}}">
          <a href="{{- path('transactions', {
            'uid': uid,
            'f':{
              'from_account': u_code,
              'from_date': transactions_from_date|date_format('day'),
            }}|pp) -}}">
            {{- trans_ary[uid].amount_out -}}
          </a>
        </td>
      {%- else -%}
        <td>0</td>
      {%- endif -%}
    {%- endif -%}

    {%- if cols.amount_total -%}
      {%- if trans_ary[uid] is defined -%}
        <td data-order="{{- trans_ary[uid].amount_total -}}">
          <a href="{{- path('transactions', {
            'uid': uid,
            'f':{
              'account_logic': 'or',
              'to_account': u_code,
              'from_account': u_code,
              'from_date': transactions_from_date|date_format('day'),
            }}|pp) -}}">
            {{- trans_ary[uid].amount_total -}}
          </a>
        </td>
      {%- else -%}
        <td>0</td>
      {%- endif -%}
    {%- endif -%}

  </tr>
{%- endfor -%}
