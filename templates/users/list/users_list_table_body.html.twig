{%- import 'macro/lbl.html.twig' as l -%}

{%- for uid, u in users -%}
  {%- set u_class =
    is_new(u) ? ' class="success"' :
    is_leaving(u) ? ' class="danger"' :
    is_intersystem(u) ? ' class="warning"' :
    is_pre_active(u) ? ' class="inactive"' :
    is_post_active(u) ? ' class="info"' : ''
  -%}
  {%- set can_link = is_active(uid) or pp_has_role('admin') -%}
  {%- set u_link = can_link ? path('users_show', {'id': uid, 'status': all_params.status}|pp) : null -%}
  {%- set u_code = (u.code ?? '') ~ ' ' ~ (u.name ?? '') -%}
  <tr{{- u_class|raw }} data-balance="{{- u.balance ?? '0' -}}" data-id="{{- uid }}">

    <td>
      {%- if pp_has_role('admin') -%}
        {%- embed 'component/bulk_check_table/checkbox.html.twig' with {
          'id': uid,
        } -%}
          {%- block label -%}
            {%- include 'component/avatar/avatar_inline.html.twig' with {
              'user': u,
            } -%}
          {%- endblock label -%}
        {%- endembed -%}
      {%- elseif can_link -%}
        <a href="{{- u_link -}}">
          {%- include 'component/avatar/avatar_inline.html.twig' with {
            'user': u,
          } -%}
        </a>
      {%- else -%}
        {%- include 'component/avatar/avatar_inline.html.twig' with {
          'user': u,
        } -%}
      {%- endif -%}
    </td>

    {%- if cols.code is defined and cols.code -%}
    <td>
      {%- if can_link -%}
      <a href="{{- u_link -}}">
        {{- u.code ?? '***' -}}
      </a>
      {%- else -%}
        {{- u.code ?? '***' -}}
      {%- endif -%}
    </td>
    {%- endif -%}

    {%- if cols.name is defined and cols.name -%}
    <td>
      {%- if can_link -%}
      <a href="{{- u_link -}}">
        {{- u.name ?? '***' -}}
      </a>
      {%- else -%}
        {{- u.name ?? '***' -}}
      {%- endif -%}
    </td>
    {%- endif -%}

    {%- if cols.full_name is defined and cols.full_name -%}
    <td>
      {%- if u.full_name_access|is_visible -%}
        {%- if can_link -%}
        <a href="{{- u_link -}}">
          {{- u.full_name ?? '***' -}}
        </a>
        {%- else -%}
          {{- u.full_name ?? '***' -}}
        {%- endif -%}
      {%- else -%}
        {{- l.btn('hidden') -}}
      {%- endif -%}
    </td>
    {%- endif -%}

    {%- if cols.full_name_access is defined and cols.full_name_access -%}
    <td>
      {{- l.btn(u.full_name_access) -}}
    </td>
    {%- endif -%}

    {%- if cols.postcode is defined and cols.postcode -%}
    <td>
      {{- u.postcode ?? '/' -}}
    </td>
    {%- endif -%}

    {%- if cols.role is defined and cols.role -%}
    <td>
      {%- if u.role == 'admin' -%}
        <span class="btn btn-info">
          {{- 'role.admin'|trans -}}
        </span>
      {%- elseif u.role == 'user' -%}
        <span class="btn btn-default">
          {{- 'role.user'|trans -}}
        </span>
      {%- elseif u.role == 'guest' -%}
        <span class="btn btn-warning">
          {{- 'role.guest'|trans -}}
        </span>
      {%- else -%}
         {{- u.role ?? '/' -}}
      {%- endif -%}
    </td>
    {%- endif -%}

    {%- if cols.balance is defined and cols.balance -%}
    <td>
      {{- u.balance ?? '0' -}}
    </td>
    {%- endif -%}

    {%- if cols.balance_on_date is defined
      and cols.balance_on_date
      and cols.balance_date is defined
      and cols.balance_date -%}
    <td>
      {{- balance_on_date_ary[uid] ?? '0' -}}
    </td>
    {%- endif -%}

    {%- if cols.min_limit is defined and cols.min_limit -%}
    <td>
      {{- u.min_limit ?? '' -}}
    </td>
    {%- endif -%}

    {%- if cols.max_limit is defined and cols.max_limit -%}
    <td>
      {{- u.max_limit ?? '' -}}
    </td>
    {%- endif -%}

    {%- if cols.comments is defined and cols.comments -%}
    <td>
      {{- u.comments ?? '***' -}}
    </td>
    {%- endif -%}

    {%- if cols.hobbies is defined and cols.hobbies -%}
    <td>
      {{- u.hobbies ?? '' -}}
    </td>
    {%- endif -%}

    {%- if cols.birthdate is defined and cols.birthdate -%}
      {%- if u.birthdate -%}
        <td data-order="{{- u.birthdate|date('U') -}}">
          {{- u.birthdate|date_format('day') -}}
        </td>
      {%- else -%}
        <td>/</td>
      {%- endif -%}
    {%- endif -%}

    {%- if cols.admin_comments is defined and cols.admin_comments -%}
    <td>
      {{- u.admin_comments ?? '' -}}
    </td>
    {%- endif -%}

    {%- if cols.periodic_overview is defined and cols.periodic_overview -%}
    <td>
      {%- if u.periodic_overview_en -%}
        <span class="btn btn-success">
          {{- 'label.on'|trans -}}
        </span>
      {%- else -%}
        <span class="btn btn-danger">
          {{- 'label.off'|trans -}}
        </span>
      {%- endif -%}
    </td>
    {%- endif -%}

    {%- if cols.created_at is defined and cols.created_at -%}
      <td data-order="{{- u.created_at|date('U') -}}">
        {{- u.created_at|date_format('day') -}}
      </td>
    {%- endif -%}

    {%- if cols.last_edit_at is defined and cols.last_edit_at -%}
      <td data-order="{{- u.last_edit_at|date('U') -}}">
        {{- u.last_edit_at|date_format('day') -}}
      </td>
    {%- endif -%}

    {%- if cols.activated_at is defined and cols.activated_at -%}
      {%- if u.activated_at -%}
        <td data-order="{{- u.activated_at|date('U') -}}">
          {{- u.activated_at|date_format('day') -}}
        </td>
      {%- else -%}
        <td>/</td>
      {%- endif -%}
    {%- endif -%}

    {%- if cols.last_login_at is defined and cols.last_login_at -%}
      {%- if last_login_ary[uid] is defined -%}
        <td data-order="{{- last_login_ary[uid]|date('U') -}}">
          {{- last_login_ary[uid]|date_format('day') -}}
        </td>
      {%- else -%}
        <td>/</td>
      {%- endif -%}
    {%- endif -%}

    {%- if cols.tags is defined and cols.tags -%}
    <td>
      {%- if tags_ary[uid] is defined -%}
        {%- for tag in tags_ary[uid] -%}
          {%- include 'component/tag.html.twig' -%}
        {%- endfor -%}
      {%- endif -%}
    </td>
    {%- endif -%}

    {%- if cols.contacts is defined -%}
      {%- for abbrev, b in cols.contacts -%}
      {%- if b -%}
        <td>
        {%- if contacts_ary[uid][abbrev] is defined -%}
          {%- for c in contacts_ary[uid][abbrev] -%}
            {%- if c.access|is_visible -%}
              {{- c.value -}}
            {%- else -%}
              <span class="btn btn-default">
                {{- 'label.hidden'|trans -}}
              </span>
            {%- endif -%}
            {%- if not loop.last -%}
              <br>
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
            /
        {%- endif -%}
        </td>
      {%- endif -%}
      {%- endfor -%}
    {%- endif -%}

    {%- if cols.distance is defined and cols.distance -%}
      {%- if distance_ary[uid] is defined -%}
        {%- if distance_ary[uid] == 'hidden' -%}
          <td data-order="50000000">
            <span class="btn btn-default">
              {{- 'label.hidden'|trans -}}
            </span>
          </td>
        {%- else -%}
          <td data-order="{{- distance_ary[uid] -}}">
            {%- if distance_ary[uid] > 1000 -%}
              {{- (distance_ary[uid] / 1000)|number_format(1, ',', '.') }} km
            {%- else -%}
              {{- distance_ary[uid] }} m
            {%- endif -%}
          </td>
        {%- endif -%}
      {%- else -%}
        <td data-order="50000000">
          <twig:ux:icon name="lucide:x"/>
        </td>
      {%- endif -%}
    {%- endif -%}

    {%- if cols.mollie is defined and cols.mollie -%}
    <td>
      {%- if mollie_ary[uid] is not defined -%}
        &nbsp;
      {%- elseif mollie_ary[uid].is_paid -%}
      <span class="label label-success"
        title="{{- mollie_ary[uid].description -}}&#10;
        {{- mollie_ary[uid].amount|replace({'.': ','}) }} EUR&#10;
        @ {{ mollie_ary[uid].paid_at|date_format('day') -}}"
      >
        {{- 'mollie.status.paid'|trans -}}
      </span>
      {%- elseif mollie_ary[uid].is_canceled -%}
      <span class="label label-default"
        title="{{- mollie_ary[uid].description -}}&#10;
        {{- mollie_ary[uid].amount|replace({'.': ','}) }} EUR&#10;
        @ {{ mollie_ary[uid].canceled_at|date_format('day') -}}"
      >
        {{- 'mollie.status.canceled'|trans -}}
      </span>
      {%- else -%}
      <span class="label label-warning"
        title="{{- mollie_ary[uid].description -}}&#10;
        {{- mollie_ary[uid].amount|replace({'.': ','}) }} EUR&#10;
        @ {{ mollie_ary[uid].created_at|date_format('day') -}}"
      >
        {{- 'mollie.status.open'|trans -}}
      </span>
      {%- endif -%}
    </td>
    {%- endif -%}

    {%- if cols.wants is defined and cols.wants -%}
      {%- if messages_ary[uid] is defined -%}
        <td data-order="{{- messages_ary[uid].wants -}}">
          <a href="{{- path('messages'|var_route, {
            'uid': uid,
            'f':{
              'user': u_code,
              'ow': ['want'],
            }}|pp) -}}">
            {{- messages_ary[uid].wants -}}
          </a>
        </td>
      {%- else -%}
        <td>0</td>
      {%- endif -%}
    {%- endif -%}

    {%- if cols.offers is defined and cols.offers -%}
      {%- if messages_ary[uid] is defined -%}
        <td data-order="{{- messages_ary[uid].offers -}}">
          <a href="{{- path('messages'|var_route, {
            'uid': uid,
            'f':{
              'user': u_code,
              'ow': ['offer'],
            }}|pp) -}}">
            {{- messages_ary[uid].offers -}}
          </a>
        </td>
      {%- else -%}
        <td>0</td>
      {%- endif -%}
    {%- endif -%}

    {%- if cols.offers_and_wants is defined and cols.offers_and_wants -%}
      {%- if messages_ary[uid] is defined -%}
        <td data-order="{{- messages_ary[uid].total -}}">
          <a href="{{- path('messages'|var_route, {
            'uid': uid,
            'f':{
              'user': u_code,
              'ow': ['offer', 'want'],
            }}|pp) -}}">
            {{- messages_ary[uid].total -}}
          </a>
        </td>
      {%- else -%}
        <td>0</td>
      {%- endif -%}
    {%- endif -%}

    {%- if cols.transactions_in is defined and cols.transactions_in -%}
      {%- if transactions_ary[uid] is defined -%}
        <td data-order="{{- transactions_ary[uid].trans_in -}}">
          <a href="{{- path('transactions', {
            'uid': uid,
            'f':{
              'to_account': u_code,
              'from_date': transactions_from_date|date_format('day'),
            }}|pp) -}}">
            {{- transactions_ary[uid].trans_in -}}
          </a>
        </td>
      {%- else -%}
        <td>0</td>
      {%- endif -%}
    {%- endif -%}

    {%- if cols.transactions_out is defined and cols.transactions_out-%}
      {%- if transactions_ary[uid] is defined -%}
        <td data-order="{{- transactions_ary[uid].trans_out -}}">
          <a href="{{- path('transactions', {
            'uid': uid,
            'f':{
              'from_account': u_code,
              'from_date': transactions_from_date|date_format('day'),
            }}|pp) -}}">
            {{- transactions_ary[uid].trans_out -}}
          </a>
        </td>
      {%- else -%}
        <td>0</td>
      {%- endif -%}
    {%- endif -%}

    {%- if cols.transactions_total is defined and cols.transactions_total -%}
      {%- if transactions_ary[uid] is defined -%}
        <td data-order="{{- transactions_ary[uid].trans_total -}}">
          <a href="{{- path('transactions', {
            'uid': uid,
            'f':{
              'account_logic': 'or',
              'to_account': u_code,
              'from_account': u_code,
              'from_date': transactions_from_date|date_format('day'),
            }}|pp) -}}">
            {{- transactions_ary[uid].trans_total -}}
          </a>
        </td>
      {%- else -%}
        <td>0</td>
      {%- endif -%}
    {%- endif -%}

    {%- if cols.amount_in is defined and cols.amount_in -%}
      {%- if transactions_ary[uid] is defined -%}
        <td data-order="{{- transactions_ary[uid].amount_in -}}">
          <a href="{{- path('transactions', {
            'uid': uid,
            'f':{
              'to_account': u_code,
              'from_date': transactions_from_date|date_format('day'),
            }}|pp) -}}">
            {{- transactions_ary[uid].amount_in -}}
          </a>
        </td>
      {%- else -%}
        <td>0</td>
      {%- endif -%}
    {%- endif -%}

    {%- if cols.amount_out is defined and cols.amount_out -%}
      {%- if transactions_ary[uid] is defined -%}
        <td data-order="{{- transactions_ary[uid].amount_out -}}">
          <a href="{{- path('transactions', {
            'uid': uid,
            'f':{
              'from_account': u_code,
              'from_date': transactions_from_date|date_format('day'),
            }}|pp) -}}">
            {{- transactions_ary[uid].amount_out -}}
          </a>
        </td>
      {%- else -%}
        <td>0</td>
      {%- endif -%}
    {%- endif -%}

    {%- if cols.amount_total is defined and cols.amount_total -%}
      {%- if transactions_ary[uid] is defined -%}
        <td data-order="{{- transactions_ary[uid].amount_total -}}">
          <a href="{{- path('transactions', {
            'uid': uid,
            'f':{
              'account_logic': 'or',
              'to_account': u_code,
              'from_account': u_code,
              'from_date': transactions_from_date|date_format('day'),
            }}|pp) -}}">
            {{- transactions_ary[uid].amount_total -}}
          </a>
        </td>
      {%- else -%}
        <td>0</td>
      {%- endif -%}
    {%- endif -%}

  </tr>
{%- endfor -%}
