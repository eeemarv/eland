
{%- include 'component/bulk_check_table/form_start.html.twig' with {
  'form': bulk_comments_form,
} -%}

{{- form_row(bulk_comments_form.comments, {
  'label': 'label.comments',
  'addon': ux_icon('lucide:message-square'),
}) -}}

<p class="alert alert-warning">
  <b>
  {{- 'users_list.bulk.comments.warning'|trans -}}
  </b>
</p>

{{- form_row(bulk_comments_form.verify, {
  'label': 'check.verify',
}) -}}

{{- form_widget(bulk_comments_form.submit, {
  'label': 'btn.edit',
  'attr': {
    'class': 'btn btn-lg btn-primary',
  },
}) -}}

{{- form_end(bulk_comments_form) -}}