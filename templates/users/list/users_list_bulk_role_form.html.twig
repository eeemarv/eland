
{%- include 'component/bulk_check_table/form_start.html.twig' with {
  'form': bulk_role_form,
} -%}

{{- form_row(bulk_role_form.role, {
  'label': false,
  'addon': ux_icon('lucide:hand'),
}) -}}

<p class="alert alert-warning">
  <b>
  {{- 'users_list.bulk.role.warning'|trans -}}
  </b>
  {%- if config_bool('intersystem.enabled') -%}
    <br>
    <b>
      {{- 'users_list.bulk.role.warning_intersystem'|trans -}}
    </b>
  {%- endif -%}
</p>

{%- include 'form/log_comment.html.twig' with {
  'form': bulk_role_form,
  'inline': false,
} -%}

{{- form_row(bulk_role_form.verify, {
  'label': 'check.verify',
}) -}}

{{- form_widget(bulk_role_form.submit, {
  'label': 'btn.edit',
  'attr': {
    'class': 'btn btn-lg btn-primary',
  },
}) -}}

{{- form_end(bulk_role_form) -}}