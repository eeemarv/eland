{%- extends 'users/base/users_single_form.html.twig' -%}

{%- block heading_title -%}
  {{- 'users_account_code_edit.title'|trans({
    'self': is_self ? 'self' : 'some_user',
    'mode': mode,
    'user': mode == 'add' ? username(id) : account(id),
  }) -}}
{%- endblock heading_title -%}

{%- block form_a -%}
  {{- form_row(form.code, {
    'label': 'label.account_code',
    'addon': ux_icon('lucide:credit-card'),
  }) -}}
{%- endblock form_a -%}
