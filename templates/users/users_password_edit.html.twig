{%- extends 'users/base/users_single_form.html.twig' -%}

{%- block heading_icon -%}
<twig:ux:icon name="lucide:key"/>
{%- endblock heading_icon -%}

{%- block heading_title -%}
  {{- 'users_password_edit.title'|trans({
    'self': is_self ? 'yes' : 'no',
    'user': account(id)
  }) -}}
{%- endblock -%}

{%- block content -%}
{%- endblock content -%}

{%- block form_a -%}
  {{- form_row(form.password, {
    'label': 'label.new_password',
    'help': 'users_password_edit.password.help',
    'addon': ux_icon('lucide:key'),
  }) -}}
{%- endblock form_a -%}

{%- block form_submit_btn -%}
  {%- include 'form/submit_edit_btn.html.twig' with {
    'label': 'btn.store'
  } -%}
{%- endblock form_submit_btn -%}

{%- block css -%}
  {{- parent() -}}
{%- endblock css -%}

{%- block js -%}
  {{- parent() -}}
{%- endblock js -%}