{%- extends 'users/base/users_overview.html.twig' -%}

{%- set csv_en = true -%}

{%- block assets_add -%}
  {{- parent() -}}
  {{- assets_add([
    'calc_sum.js',
    'users_distance.js',
    'datepicker'
  ]) -}}
  {%- if pp_has_role('admin') -%}
    {{- assets_add([
      'codemirror',
      'summernote',
      'summernote_email.js',
      'table_sel.js',
    ]) -}}
  {%- endif -%}
{%- endblock assets_add -%}

{%- block btn_show_columns -%}
  {%- include 'include/nav/btn_show_columns.html.twig' -%}
{%- endblock btn_show_columns -%}

{%- block btn_top_bulk -%}
  {%- if pp_has_role('admin') -%}
    {%- include 'include/btn_top/bulk.html.twig' -%}
  {%- endif -%}
{%- endblock btn_top_bulk -%}

{%- block columns_form -%}
  {{- columns_form_raw|raw -}}
{%- endblock columns_form -%}

{%- block filter_form_a -%}
  {%- include 'form/q_filter.html.twig' -%}
{%- endblock filter_form_a -%}

{%- block content -%}{%- endblock -%}

{%- block data -%}
  {%- if row_count -%}
    {{- data_list_raw|raw -}}
  {%- else -%}
    {%- include 'include/no_results.html.twig' -%}
  {%- endif -%}
{%- endblock data -%}

{%- block footnote -%}
  <div class="row">
    <div class="col-md-12">
      <p>
        <span class="pull-right">{{- 'label.balance_sum'|trans({
          'balance_sum': '<span id="sum"></span> ' ~ config_str('transactions.currency.name')
        })|raw -}}
        </span>
      </p>
    </div>
  </div>
{%- endblock footnote -%}

{%- block bulk_actions -%}
  {%- if pp_has_role('admin') -%}
    {%- include 'include/bulk_select_btns.html.twig' -%}
    {%- include 'users/list/users_list_bulk.html.twig' -%}
  {%- endif -%}
{%- endblock bulk_actions -%}

{%- block css -%}
  {{- parent() -}}
{%- endblock css -%}

{%- block js -%}
  {{- parent() -}}
{%- endblock js -%}