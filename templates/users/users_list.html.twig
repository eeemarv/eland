{%- extends 'users/base/users_overview.html.twig' -%}

{%- block content_controllers -%}
user-count-table datatable
{%- if pp_has_role('admin') %} bulk-check-table csv{%- endif -%}
{%- endblock content_controllers -%}

{%- block content_controllers_attr -%}
data-csv-filename-value="{{- 'label.users'|trans|lower|replace({' ': '_'}) -}}"
data-datatable-sortable-value="true"
{%- endblock content_controllers_attr -%}

{%- block csv_download_btn -%}
  {%- if pp_has_role('admin') -%}
  {%- include 'include/btn_top/csv_download.html.twig' -%}
  {%- endif -%}
{%- endblock csv_download_btn -%}

{%- block assets_add -%}
  {{- parent() -}}
  {#}
  {{- assets_add([
    'users_distance.js',
    'datepicker'
  ]) -}}
  {%- if pp_has_role('admin') -%}
    {{- assets_add([
      'codemirror',
      'summernote',
      'summernote_email.js',
    ]) -}}
  {%- endif -%}
  {#}
{%- endblock assets_add -%}

{%- block btn_top_bulk -%}
  {%- if pp_has_role('admin') -%}
    {%- include 'include/btn_top/bulk.html.twig' -%}
  {%- endif -%}
{%- endblock btn_top_bulk -%}

{%- block heading_append -%}
  {%- include 'include/btn/btn_cols.html.twig' -%}
{%- endblock heading_append -%}

{%- block columns_form -%}
  {%- include 'users/list/users_list_cols_form.html.twig' -%}
{%- endblock columns_form -%}

{%- block filter_form_a -%}
  {%- include 'form/q_filter.html.twig' -%}
{%- endblock filter_form_a -%}

{%- block pane_select -%}
  {%- include 'users/list/users_nav_tabs.html.twig' -%}
{%- endblock pane_select -%}

{%- block content -%}{%- endblock -%}

{%- block data -%}
  {%- if row_count -%}
    {%- include 'users/list/users_list_table.html.twig' -%}
  {%- else -%}
    {%- include 'include/no_results.html.twig' -%}
  {%- endif -%}
{%- endblock data -%}

{%- block footnote -%}
  <div class="row">
    <div class="col-md-12">
      <p>
        <span class="pull-right">{{- 'label.balance_sum'|trans({
          'balance_sum': '<span data-user-count-table-target="totalBalance"></span> ' ~ config_str('transactions.currency.name')
        })|raw -}}
        </span>
      </p>
    </div>
  </div>
{%- endblock footnote -%}

{%- block bulk_actions -%}
  {%- if pp_has_role('admin') -%}
    {%- include 'users/list/users_list_bulk.html.twig' -%}
  {%- endif -%}
{%- endblock bulk_actions -%}
