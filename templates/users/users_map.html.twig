{%- extends 'users/base/users_overview.html.twig' -%}

{%- block assets_add -%}
  {{- parent() -}}
  {{- assets_add(['leaflet', 'users_map.js']) -}}
{%- endblock assets_add -%}

{%- block content -%}{%- endblock -%}

{%- block data -%}
  {%- if users|length -%}
    {%- include 'users/map/users_map.html.twig' -%}
  {%- else -%}
    {%- include 'include/no_results.html.twig' -%}
  {%- endif -%}
{%- endblock data -%}

{%- block css -%}
  {{- parent() -}}
{%- endblock css -%}

{%- block js -%}
  {{- parent() -}}
{%- endblock js -%}