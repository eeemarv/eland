{%- extends 'news/base/news_base.html.twig' -%}

{%- block btn_top_edit -%}
  {%- if pp_has_role('admin') -%}
    {%- include 'include/btn_top/edit.html.twig' with {
      'btn_route': 'news_edit',
      'btn_title': 'news_edit.title',
      'btn_title_trans_params': {
        'subject': news_item.subject
      }
    } -%}
  {%- endif -%}
{%- endblock btn_top_edit -%}

{%- block btn_top_del -%}
  {%- if pp_has_role('admin') -%}
    {%- include 'include/btn_top/del.html.twig' with {
      'btn_route': 'news_del',
      'btn_title': 'news_del.title',
      'btn_title_trans_params': {
        'subject': news_item.subject
      }
    } -%}
  {%- endif -%}
{%- endblock btn_top_del -%}

{%- block btn_item_nav -%}
  {%- set sort_asc = config_bool('news.sort.asc') -%}
  {%- set pprev_id = sort_asc ? prev_id : next_id -%}
  {%- set nnext_id = sort_asc ? next_id : prev_id -%}

  <div class="btn-group ml-5p" role="group">
  <a href="
  {%- if pprev_id -%}
    {{- path('news_show', {}|pp|merge({'id': pprev_id})) -}}"
  {%- else -%}
  #" disabled
  {%- endif %} class="btn btn-default btn-lg" title="{{- 'nav.prev'|trans -}}">
    <twig:ux:icon name="lucide:chevron-up"/>
  </a>

  <a href="
  {%- if nnext_id -%}
    {{- path('news_show', {}|pp|merge({'id': nnext_id})) -}}"
  {%- else -%}
  #" disabled
  {%- endif %} class="btn btn-default btn-lg" title="{{- 'nav.next'|trans -}}">
    <twig:ux:icon name="lucide:chevron-down"/>
  </a>

  <a href="{{- path('news'|var_route, {}|pp) -}}" class="btn btn-default btn-lg" title="{{- 'nav.list'|trans -}}">
    <twig:ux:icon name="lucide:calendar-range"/>
  </a>
</div>
{%- endblock btn_item_nav -%}

{%- block heading_title -%}
  {{- 'news_show.title'|trans({
    'subject': news_item.subject
  }) -}}
{%- endblock heading_title -%}

{%- block data -%}
  {%- include 'news/include/news_item.html.twig' with {
    'post': news_item,
    'show_subject': false
  } -%}
{%- endblock data -%}

{%- block css -%}
  {{- parent() -}}
{%- endblock css -%}

{%- block js -%}
  {{- parent() -}}
{%- endblock js -%}