{%- extends 'news/base/news_overview.html.twig' -%}

{%- block content_controllers -%}
{%- if pp_has_role('admin') %} csv{%- endif -%}
{%- endblock content_controllers -%}

{%- block content_controllers_attr -%}
data-csv-filename-value="{{- 'label.news'|trans|lower|replace({' ': '_'}) -}}"
{%- endblock content_controllers_attr -%}

{%- block csv_download_btn -%}
  {%- if pp_has_role('admin') -%}
  {%- include 'include/btn_top/csv_download.html.twig' -%}
  {%- endif -%}
{%- endblock csv_download_btn -%}

{%- block data -%}
  {%- if news_items -%}
    {%- include 'news/include/news_list.html.twig' -%}
  {%- else -%}
    {%- include 'include/no_results.html.twig' with {
      'message': 'news.no_items'
    } -%}
  {%- endif -%}
{%- endblock data -%}

{%- block css -%}
  {{- parent() -}}
{%- endblock css -%}

{%- block js -%}
  {{- parent() -}}
{%- endblock js -%}