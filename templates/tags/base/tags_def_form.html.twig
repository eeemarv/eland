{%- extends 'tags/base/tags_base.html.twig' -%}

{%- set cancel_route = 'tags' -%}
{%- set cancel_route_params = {
  'tag_type': tag_type
} -%}

{%- block heading_icon -%}
<twig:ux:icon name="lucide:tag"/>
{%- endblock heading_icon -%}

{%- block form_a -%}
<div data-controller="tag-preview">
  <div class="row">
    <div class="col-sm-6">
      {{- form_row(form.txt, {
        'label': 'label.text',
        'addon': ux_icon('lucide:pencil'),
        'attr': {
          'data-tag-preview-target': 'text',
          'data-action': 'input->tag-preview#update'
        }
      }) -}}
    </div>
    <div class="col-sm-6">
      <div class="form-group">
          <label class="control-label" for="tag-i">
            {{- 'label.example'|trans -}}
          </label>
          <div class="input-group">
            <span class="tag-eland label"
                  data-tag-preview-target="preview"
                  title="{{- form.children.description.vars.value -}}"
                  style="border: 1px solid;"
            >
              {{- form.children.txt.vars.value -}}
            </span>
          </div>
      </div>
    </div>
  </div>
  <div class="row">
      <div class="col-sm-6">
        {{- form_row(form.bg_color, {
          'label': 'label.bg_color',
          'addon': ux_icon('lucide:palette'),
          'attr': {
            'data-tag-preview-target': 'bgColor',
            'data-action': 'input->tag-preview#update'
          }
        }) -}}
      </div>
      <div class="col-sm-6">
        {{- form_row(form.txt_color, {
          'label': 'label.txt_color',
          'addon': ux_icon('lucide:palette'),
          'attr': {
            'data-tag-preview-target': 'textColor',
            'data-action': 'input->tag-preview#update'
          }
        }) -}}
      </div>
  </div>
  {{- form_row(form.description, {
    'label': 'label.description',
    'addon': ux_icon('lucide:pencil'),
    'attr': {
      'data-tag-preview-target': 'description',
      'data-action': 'input->tag-preview#update'
    }
  }) -}}
</div>
{%- endblock form_a -%}
