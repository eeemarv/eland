{%- extends 'messages/base/messages_edit_form.html.twig' -%}

{%- if pp_has_role('admin') -%}
  {%- set admin_heading = true -%}
{%- endif -%}

{%- block heading_title -%}
  {{- 'messages_edit.title'|trans({
    'offer_want': message.offer_want,
    'self':su_is_owner(message.user_id) ? 'self' : 'some_user',
    'subject': message.subject,
    'user': account(message.user_id, schema)
  }) -}}
{%- endblock heading_title -%}

{%- block css -%}
  {{- parent() -}}
{%- endblock css -%}

{%- block js -%}
  {{- parent() -}}
{%- endblock js -%}