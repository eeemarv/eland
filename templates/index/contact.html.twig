{%- extends 'index/base/index_contact.html.twig' -%}

{%- set email_help -%}
	<ul>
		<li>{{- 'help.email_validation_link'|trans -}}</li>
		<li>{{- 'help.email_privacy'|trans -}}</li>
	</ul>
{%- endset -%}

{%- block container -%}
  {% if 'open_email' in app.flashes('content') %}

    <div class="panel panel-success">
      <div class="panel-heading">
        <h3>
          {{- 'index_contact_form.flash.open_email'|trans -}}
        </h3>
      </div>
      <div class="panel-body">
        <a href="{{- path('index') -}}" class="btn btn-lg btn-primary">
          {{- 'index_contact_form.btn.back_to_index'|trans -}}
        </a>
      </div>
    </div>

  {%- else -%}

    <div class="panel panel-info">
      <div class="panel-heading">
        {{- form_start(form, {'attr': {'novalidate': 'novalidate'}}) -}}
        {{- form_errors(form) -}}

        {{- form_row(form.email_address, {
          'label': 'label.your_email',
          'help_html': true,
          'help': 'var',
          'help_translation_parameters': {
            'var': email_help
          },
          'pre_addon': {
            'fa': 'envelope-o'
          }
        }) -}}

        {{- form_row(form.message, {
          'label': 'label.your_message',
          'attr': {
            'rows': 5
          }
        }) -}}

        {%- include 'form/captcha.html.twig' -%}

        {%- include 'form/submit_send_btn.html.twig' -%}
        {{- form_end(form) -}}
      </div>
    </div>

  {% endif %}

	{%- embed 'include/hosting.html.twig' -%}
		{%- block contact_form_link -%}
			dit contactformulier
		{%- endblock -%}
	{%- endembed -%}
{%- endblock container -%}
