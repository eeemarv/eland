<a href="{{- path(btn_route, {'id': id}|pp|merge(btn_route_params|default({}))) -}}" class="btn btn-danger btn-lg" title="{{- (btn_title|default('btn.del'))|trans(btn_title_trans_params|default({})) -}}">
  <twig:ux:icon name="lucide:trash"/>
  <span class="hidden-xs hidden-sm">
    &nbsp;
    {{- 'btn.del'|trans -}}
  </span>
</a>