{%- set back = app.session.get('last:' ~ su_schema()) -%}
{%- set b_role_short = back.role_short ?? su_role_short() -%}

{%- embed 'embed/menu_dropdown.html.twig' -%}

  {%- block label -%}
    {%- if su_is_master() -%}
      <span class="hidden-sm hidden-xs ms-1">
        Master
      </span>
    {%- else  -%}
      {%- include 'component/avatar/avatar_inline.html.twig' with {
        'user': {
          'name': username(su_id(), su_schema()),
          'id': su_id(),
        },
      } -%}
      <span class="hidden-sm hidden-xs ms-1">
        {{- account(su_id(), su_schema()) -}}
      </span>
    {%- endif -%}
  {%- endblock label -%}

  {%- block menu_items -%}
    {%- if not su_is_system_self() -%}
    <li class="dropdown-header">
      {{- config_str('system.name', su_schema()) }}
    </li>
    {%- endif -%}

    {%- if not su_is_master() -%}
      <li{%- if 'users_show_self' == route and su_is_system_self() %} class="active"{%- endif -%}>
        <a href="{{- path('users_show_self', {
          'schema': su_schema(),
          'role_short': b_role_short,
        }) -}}">
          <twig:ux:icon name="lucide:user"/>
          &nbsp;
          {{- ('users_show.title')|trans({
            'self': 'self',
            'user': '',
          }) -}}
        </a>
      </li>

      {%- if config_bool('messages.enabled', su_schema()) -%}
        <li{%- if 'messages_self'|var_route == route and su_is_system_self() %} class="active"{%- endif -%}>
          <a href="{{- path('messages_self'|var_route, {
            'schema': su_schema(),
            'role_short': b_role_short,
          }) -}}">
            <twig:ux:icon name="lucide:newspaper"/>
            &nbsp;
            {{- 'messages.title'|trans({
              'self': 'self',
              'with_without_category': 'all',
            }) -}}
          </a>
        </li>
      {%- endif -%}

      {%- if config_bool('transactions.enabled', su_schema()) -%}
        <li{%- if 'transactions_self' == route and su_is_system_self() %} class="active"{%- endif -%}>
          <a href="{{- path('transactions_self', {
              'schema': su_schema(),
              'role_short': b_role_short,
          }) -}}">
            <twig:ux:icon name="lucide:arrow-left-right"/>
            &nbsp;
            {{- 'transactions.title'|trans({
              'self': 'self',
            }) -}}
          </a>
        </li>
      {%- endif -%}

      <li class="divider"></li>

    {%- endif -%}

    <li>
      <a href="{{- path('logout', {
        'schema': su_schema(),
        'role_short': b_role_short,
      }) -}}">
        <twig:ux:icon name="lucide:log-out"/>
        &nbsp;
        {{- 'logout.title'|trans -}}
      </a>
    </li>
  {%- endblock menu_items -%}
{%- endembed -%}