{%- set back = app.session.get('last:' ~ su_schema()) -%}
{%- set b_role_short = back.role_short ?? su_role_short() -%}

{%- embed 'embed/menu_dropdown.html.twig' -%}
  {%- block label -%}
    <twig:ux:icon name="lucide:bell"/>
    <span class="label label-as-badge label-danger">2</span>
    <span class="hidden-sm hidden-xs ms-1">
      {{- 'notifications.title'|trans -}}
    </span>
  {%- endblock label -%}

  {%- block menu_items -%}

    <!-- Dit gedeelte wordt dynamisch gevuld door Stimulus -->
    <li data-navbar-notifications-target="listContainer" class="d-flex flex-column" style="max-height: 360px; overflow-y: auto;">
        <div class="text-center p-3 text-muted">Laden...</div>
    </li>

    <li class="divider"></li>
    <li{%- if route == 'notifications' %} class="active"{%- endif  -%}>
      <a href="{{- path('notifications', {
          'schema': su_schema(),
          'role_short': b_role_short,
        }) -}}">
        <twig:ux:icon name="lucide:bell"/>
        &nbsp;
        {{- 'notifications.view_all'|trans  -}}
      </a>
    </li>

  {%- endblock menu_items -%}
{%- endembed -%}