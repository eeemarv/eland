<div class="panel panel-default" id="bulk_actions">
  <div class="panel-heading">
    <input type="button"
      class="btn btn-default btn-lg"
      data-table-sel="invert"
      value="{{- 'btn.select_invert'|trans -}}" />
    &nbsp;
    <input type="button"
      class="btn btn-default btn-lg"
      data-table-sel="all"
      value="{{- 'btn.select_all'|trans -}}" />
    &nbsp;
    <input type="button"
      class="btn btn-default btn-lg"
      data-table-sel="none"
      value="{{- 'btn.select_none'|trans -}}" />
  </div>
</div>
