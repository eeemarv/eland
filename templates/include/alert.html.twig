{%- for type, messages in app.flashes(['error', 'warning', 'success', 'info']) -%}
  {%- if messages is not empty -%}
    <div class="row">
      <div class="col-xs-12">
        <div class="mt-5p alert alert-{%- if type == 'error' -%}danger{%- else -%}{{- type -}}{%- endif %} alert-dismissible" role="alert">
          <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
          </button>

          {%- for message in messages -%}
            {%- if message is iterable -%}
              {%- set params = message.params is defined ? message.params : [] -%}
              {%- if message.is_raw is defined and message.is_raw -%}
                {{- message.key|trans(params)|raw -}}
              {%- elseif message.user is defined
                and message.user.id is defined
                and message.user.name is defined -%}
                {%- if pp_has_role('admin') -%}
                  <a href="{{- path('users_show', {
                  'id': message.user.id}|pp) -}}">
                    {{- message.user.code ?? '***' }} {{ message.user.name -}}
                  </a>
                {%- else -%}
                  {{- message.user.code ?? '***' }} {{ message.user.name -}}
                {%- endif -%}
              {%- else -%}
                {{- message.key|trans(params) -}}
              {%- endif -%}
            {%- else -%}
              {{- message|raw -}}
            {%- endif -%}

            {%- if not loop.last -%}
              <br>
            {%- endif -%}
          {%- endfor -%}

        </div>
      </div>
    </div>
  {%- endif -%}
{%- endfor -%}
