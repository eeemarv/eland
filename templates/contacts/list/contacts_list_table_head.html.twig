{%- set order_by = pag_params.s.order_by -%}
{%- set asc = pag_params.s.asc -%}
{%- set pag = {'start': 0, 'limit':pag_params.p.limit} -%}

{%- if pp_has_role('admin') and bulk_actions_enabled -%}
{# selector column #}
<th data-priority="1">
  &nbsp;
</th>
{%- endif -%}

<th data-priority="1">
  <a href="{{- path('contacts', pag_params|merge({
    's': {
      'order_by': 'tc.abbrev',
      'asc': asc ? '0' : '1',
    },
    'p': pag,
    })|pp) -}}">

    {{- 'label.type'|trans -}}
    &nbsp;
    {%- if order_by != 'tc.abbrev' -%}
      <twig:ux:icon name="lucide:chevrons-up-down" class="text-warning"/>
    {%- elseif asc -%}
      <twig:ux:icon name="lucide:chevron-up"/>
    {%- else -%}
      <twig:ux:icon name="lucide:chevron-down"/>
    {%- endif -%}
  </a>
</th>

