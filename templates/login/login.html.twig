{%- extends 'base/navbar.html.twig' -%}

{%- set active_menu = 'login' -%}

{%- block content -%}
{%- endblock content -%}

{%- block form_a -%}
  {{- form_row(form.login, {
    'label': 'login.login.label',
    'help': 'login.login.help',
    'pre_addon': {
      'fa': 'user'
    }
  }) -}}

  {{- form_row(form.password, {
    'label': 'label.password',
    'help': 'login.password_reset_link',
    'help_translation_parameters': {
      'ao': '<a href="' ~ path('password_reset', {}|pp) ~ '">',
      'ac': '</a>',
    },
    'help_html': true,
    'pre_addon': {
      'fa': 'key'
    }
  }) -}}
{%- endblock form_a -%}

{%- block form_cancel_btn -%}
{%- endblock form_cancel_btn -%}

{%- block form_submit_btn -%}
  {%- include 'form/submit_send_btn.html.twig' with {
    'label': 'btn.login'
  } -%}
{%- endblock form_submit_btn -%}

{%- block css -%}
  {{- parent() -}}
{%- endblock css -%}

{%- block js -%}
  {{- parent() -}}
{%- endblock js -%}