<div class="row mb-5p">

  {{- form_row(filter_form.q, {
    'label': false,
    'col': 'sm-6',
    'addon': ux_icon('lucide:search'),
    'attr': {
      'placeholder': 'label.description'
    },
    'id': 'q'
  }) -}}

  {{- form_row(filter_form.user, {
    'label': false,
    'col': 'sm-6',
    'addon': ux_icon('lucide:user'),
    'attr': {
      'placeholder': 'label.account_code'
    }
  }) -}}

</div>
<div class="row mb-5p">

  {{- form_row(filter_form.status, {
    'label': false,
    'col': 'sm-12',
    'count_ary': count_ary
  }) -}}

</div>
<div class="row mb-5p">

  {{- form_row(filter_form.from_date, {
    'label': false,
    'col': 'sm-5',
    'addon': 'label.from_date'|trans ~ ' '
      ~ ux_icon('lucide:calendar'),
  }) -}}

  {{- form_row(filter_form.to_date, {
    'label': false,
    'col': 'sm-5',
    'addon': 'label.to_date'|trans ~ ' '
      ~ ux_icon('lucide:calendar'),
  }) -}}

  {{- form_row(filter_form.show, {
    'label': 'btn.show',
    'col': 'sm-2',
    'attr': {
      'class': 'btn btn-default btn-block'
    }
  }) -}}
</div>
