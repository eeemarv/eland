{%- extends 'mollie/base/mollie_base.html.twig' -%}

{%- block content_controllers -%}
datatable bulk-check-table csv
{%- endblock content_controllers -%}

{%- block content_controllers_attr -%}
data-csv-filename-value="mollie"
{%- endblock content_controllers_attr -%}

{%- block btn_top_add -%}
  {%- include 'include/btn_top/add.html.twig' with {
    'btn_route': 'mollie_payments_add',
    'btn_title': 'mollie_payments_add.title'
  } -%}
{%- endblock btn_top_add -%}

{%- block btn_top_bulk -%}
  {%- include 'include/btn_top/bulk.html.twig' -%}
{%- endblock btn_top_bulk -%}

{%- block btn_top_config -%}
<a href="{{- path('mollie_config', {}|pp) -}}" class="btn btn-info btn-lg" title="{{- 'mollie_config.title'|trans -}}">
  <twig:ux:icon name="lucide:settings"/>
  <span class="hidden-xs hidden-sm">
    &nbsp;
    {{- 'btn.config'|trans -}}
  </span>
</a>
{%- endblock btn_top_config -%}

{%- block csv_download_btn -%}
  {%- include 'include/btn_top/csv_download.html.twig' -%}
{%- endblock csv_download_btn -%}

{%- block assets_add -%}
  {{- parent() -}}
  {{- assets_add([
    'codemirror',
    'summernote',
    'summernote_email.js',
    'datepicker'
  ]) -}}
{%- endblock assets_add -%}

{%- set admin_heading = true -%}

{%- block heading_title -%}
  {{- 'mollie_payments.title'|trans -}}
{%- endblock heading_title -%}

{%- block heading_append -%}
  {%- include 'include/filter/heading_filter.html.twig' -%}
  {%- include 'include/filter/heading_btn_filter.html.twig' -%}
{%- endblock heading_append -%}

{%- block filter_form_a -%}
  {%- include 'mollie/payments/mollie_payments_filter_form.html.twig' -%}
{%- endblock filter_form_a -%}

{%- block pagination -%}
  {%- include 'include/pagination/pagination.html.twig' -%}
{%- endblock pagination -%}

{%- block data -%}
  {%- if row_count -%}
    {%- include 'mollie/payments/mollie_payments_table.html.twig' -%}
  {%- else -%}
    {%- include 'include/no_results.html.twig' -%}
  {%- endif -%}
{%- endblock data -%}

{%- block bulk_actions -%}
  {%- include 'mollie/payments/mollie_payments_bulk.html.twig' -%}
{%- endblock bulk_actions -%}
