{%- extends 'mollie/config/mollie_config_form.html.twig' -%}

{%- block form_header -%}
{%- if form.vars.keys_missing -%}
  <div class="alert alert-danger">
    {{- 'mollie_config.mode.keys_missing'|trans -}}
  </div>
{%- endif -%}
{%- endblock form_header -%}

{%- block form_a -%}
  {{- form_row(form.mollie_mode) -}}
{%- endblock form_a -%}

{%- set cancel_route = 'mollie_payments' -%}
