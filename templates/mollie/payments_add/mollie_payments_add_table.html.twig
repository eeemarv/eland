<div class="bg-white">
  <table class="table table-bordered table-striped table-hover"
    data-mollie-payments-add-count-target="table"
    data-controller="mollie-payments-add-count"
  >
    <thead>
      <tr>
        {%- include 'mollie/payments_add/mollie_payments_add_table_head.html.twig' -%}
      </tr>
    </thead>
    <tbody>
      {%- include 'mollie/payments_add/mollie_payments_add_table_body.html.twig' -%}
    </tbody>
    <tfoot>
      <td colspan="4">
        {{- 'label.total'|trans }}:
        <b><span data-mollie-payments-add-count-target="totalAmount">0</span> EUR</b>
        {{ 'mollie_payments_add.number_requests'|trans }}:
        <b><span data-mollie-payments-add-count-target="paymentsCount">0</span></b>
      </td>
    </tfoot>
  </table>
</div>