{%- embed 'embed/table.html.twig' -%}
  {%- import 'macro/lbl.html.twig' as lbl -%}
  {%- block thead -%}
    <th data-priority="1">
      {{- 'label.subject'|trans -}}
    </th>
    <th data-type="num" data-priority="5">
      {{- 'label.replies'|trans -}}
    </th>
    <th data-priority="3">
      {{- 'label.user'|trans -}}
    </th>
    <th data-type="num" data-priority="4">
      {{- 'label.created'|trans -}}
    </th>
    {%- if show_access -%}
      <th data-priority="10">
        {{- 'access.visible_for'|trans -}}
      </th>
    {%- endif -%}
  {%- endblock thead -%}

  {%- block tbody -%}
    {%- for t in topics -%}
      <tr>
        <td>
          {{- t.subject|link('forum_topic', {'id': t.id})|raw -}}
        </td>
        <td>
          {{- t.reply_count -}}
        </td>
        <td>
          {{- account(t.user_id)|link('users_show', {'id': t.user_id})|raw -}}
        </td>
        <td data-order="{{- t.created_at|date('U') -}}">
          {{- t.created_at|date_format('min') -}}
        </td>
        {%- if show_access -%}
          <td>
            {{- lbl.btn(t.access) -}}
          </td>
        {%- endif -%}
      </tr>
    {%- endfor -%}
  {%- endblock tbody -%}
{%- endembed -%}