{%- extends 'forum/base/forum_base.html.twig' -%}

{%- block content_controllers -%}
datatable
{%- if pp_has_role('admin') %} csv{%- endif -%}
{%- endblock content_controllers -%}

{%- block content_controllers_attr -%}
data-csv-filename-value="{{- 'label.forum_topics'|trans|lower|replace({' ': '_'}) -}}"
data-datatable-sortable-value="true"
{%- endblock content_controllers_attr -%}

{%- block btn_top_add -%}
  {%- if pp_has_role('admin') or pp_has_role('user') -%}
    {%- include 'include/btn_top/add.html.twig' with {
      'btn_route': 'forum_add_topic',
      'btn_title': 'forum_add_topic.title'
    } -%}
  {%- endif -%}
{%- endblock btn_top_add -%}

{%- block csv_download_btn -%}
  {%- if pp_has_role('admin') -%}
  {%- include 'include/btn_top/csv_download.html.twig' -%}
  {%- endif -%}
{%- endblock csv_download_btn -%}

{%- block filter_form_a -%}
  {%- include 'form/q_filter.html.twig' -%}
{%- endblock filter_form_a -%}

{%- block data -%}
  {%- if topics -%}
    {%- include 'forum/include/topics_list.html.twig' -%}
  {%- else -%}
    {%- include 'include/no_results.html.twig' with {
      'message': 'forum.no_topics'
    } -%}
  {%- endif -%}
{%- endblock data -%}

{%- block css -%}
  {{- parent() -}}
{%- endblock css -%}

{%- block js -%}
  {{- parent() -}}
{%- endblock js -%}