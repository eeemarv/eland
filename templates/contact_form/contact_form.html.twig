{%- extends 'base/navbar.html.twig' -%}

{%- set active_menu = 'contact_form' -%}

{%- block content -%}
  {% if 'open_email' in app.flashes('content') %}

    <div class="panel panel-success">
      <div class="panel-heading">
        <h3>
          {{- 'flash.open_email_confirm_link'|trans -}}
        </h3>
      </div>
      <div class="panel-body">
        <a href="{{- path('home', {}|pp) -}}" class="btn btn-lg btn-primary">
          {{- 'btn.back_to_home'|trans -}}
        </a>
      </div>
    </div>

  {%- endif -%}
{%- endblock content -%}

{%- block form_a -%}
  {{- form_row(form.email, {
    'label': 'label.your_email',
    'help': 'help.email_validation_link',
    'pre_addon': {
      'fa': 'envelope-o'
    }
  }) -}}

  {{- form_row(form.message, {
    'label': 'label.your_message',
    'attr': {
      'rows': 5
    }
  }) -}}

  {%- include 'form/captcha.html.twig' -%}
{%- endblock form_a -%}

{%- block form_cancel_btn -%}
{%- endblock form_cancel_btn -%}

{%- block form_submit_btn -%}
  {%- include 'form/submit_send_btn.html.twig' -%}
{%- endblock form_submit_btn -%}

{%- block css -%}
  {{- parent() -}}
{%- endblock css -%}

{%- block js -%}
  {{- parent() -}}
{%- endblock js -%}
