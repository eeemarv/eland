{%- extends 'base/navbar.html.twig' -%}

{%- set active_menu = 'contact_form' -%}

{%- block content -%}
  {#}
	<div class="panel panel-{{- success ? 'success' : 'danger' -}}">
		<div class="panel-heading">
			<h3>
        {%- if success -%}
				  {{- 'contact_form_confirm.success'|trans -}}
        {%- else -%}
				  {{- 'contact_form_confirm.fail'|trans -}}
        {%- endif -%}
			</h3>
		</div>
		<div class="panel-body">
			<a href="{{- path('home', pp_ary()) -}}" class="btn btn-lg btn-primary">
				{{- 'contact_form_confirm.back_to_home'|trans -}}
			</a>
		</div>
	</div>
  {#}

	<div class="panel panel-{%- if success -%}success{%- else -%}danger{%- endif -%}">
		<div class="panel-heading">
			<h3>
        {%- if success -%}
				  {{- 'contact_form_confirm.success'|trans -}}
        {%- elseif is_already_confirmed -%}
				  {{- 'contact_form_confirm.already_confirmed'|trans({
            'confirmed_at': confirmed_at|date_format('min')
          }) -}}
        {%- elseif is_expired -%}
				  {{- 'contact_form_confirm.expired'|trans -}}
        {%- elseif is_not_found -%}
				  {{- 'contact_form_confirm.not_found'|trans -}}
        {%- endif -%}
			</h3>
		</div>
		<div class="panel-body">
			<a href="{{- path('home', {}|pp) -}}" class="btn btn-lg btn-primary">
				{{- 'contact_form_confirm.btn.back_to_home'|trans -}}
			</a>

      {%- if not success and not is_already_confirmed -%}
        &nbsp;
        <a href="{{- path('contact_form', {}|pp) -}}" class="btn btn-lg btn-primary">
          {{- 'contact_form_confirm.btn.try_again'|trans -}}
        </a>
      {%- endif -%}
		</div>
	</div>
{%- endblock content -%}

{%- block css -%}
    {{- parent() -}}
{%- endblock css -%}

{%- block js -%}
    {{- parent() -}}
{%- endblock js -%}
