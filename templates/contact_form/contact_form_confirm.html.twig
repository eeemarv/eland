{%- extends 'base/navbar.html.twig' -%}

{%- set active_menu = 'contact_form' -%}

{%- block content -%}
	<div class="panel panel-{{- success ? 'success' : 'danger' -}}">
		<div class="panel-heading">
			<h3>
        {%- if success -%}
				  {{- 'contact_form_confirm.success'|trans -}}
        {%- else -%}
				  {{- 'contact_form_confirm.fail'|trans -}}
        {%- endif -%}
			</h3>
		</div>
		<div class="panel-body">
			<a href="{{- path('home', pp_ary()) -}}" class="btn btn-lg btn-primary">
				{{- 'contact_form_confirm.back_to_home'|trans -}}
			</a>
		</div>
	</div>
{%- endblock content -%}

{%- block css -%}
    {{- parent() -}}
{%- endblock css -%}

{%- block js -%}
    {{- parent() -}}
{%- endblock js -%}
