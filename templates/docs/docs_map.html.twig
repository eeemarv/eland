{%- extends 'docs/base/docs_base.html.twig' -%}

{%- block content_controllers -%}
{%- if pp_has_role('admin') %} csv{%- endif -%}
{%- endblock content_controllers -%}

{%- block content_controllers_attr -%}
data-csv-filename-value="{{- 'label.docs'|trans|lower -}}"
{%- endblock content_controllers_attr -%}

{%- block btn_top_add -%}
  {%- if pp_has_role('admin') -%}
    {%- include 'include/btn_top/add.html.twig' with {
      'btn_route': 'docs_add',
      'btn_route_params': {
        'map_id': id
      },
      'btn_title': 'docs_add.title'
    } -%}
  {%- endif -%}
{%- endblock btn_top_add -%}

{%- block btn_top_edit -%}
  {%- if pp_has_role('admin') -%}
    {%- include 'include/btn_top/edit.html.twig' with {
      'btn_route': 'docs_map_edit',
      'btn_title': 'docs_map_edit.title',
      'btn_title_trans_params': {
        'name': doc_map.name
      }
    } -%}
  {%- endif -%}
{%- endblock btn_top_edit -%}

{%- block btn_item_nav -%}
<div class="btn-group ml-5p" role="group">
  <a href="
  {%- if prev_id -%}
    {{- path('docs_map', {}|pp|merge({'id': prev_id})) -}}"
  {%- else -%}
  #" disabled
  {%- endif %} class="btn btn-default btn-lg" title="{{- 'nav.prev'|trans -}}">
    <twig:ux:icon name="lucide:chevron-up"/>
  </a>

  <a href="
  {%- if next_id -%}
    {{- path('docs_map', {}|pp|merge({'id': next_id})) -}}"
  {%- else -%}
  #" disabled
  {%- endif %} class="btn btn-default btn-lg" title="{{- 'nav.next'|trans -}}">
    <twig:ux:icon name="lucide:chevron-down"/>
  </a>

  <a href="{{- path('docs', {}|pp) -}}" class="btn btn-default btn-lg" title="{{- 'nav.list'|trans -}}">
    <twig:ux:icon name="lucide:files"/>
  </a>
</div>
{%- endblock btn_item_nav -%}

{%- block heading_title -%}
  {{- 'docs_map.title'|trans({
    'name': doc_map.name
  }) -}}
{%- endblock heading_title -%}

{%- block csv_download_btn -%}
  {%- include 'include/btn_top/csv_download.html.twig' -%}
{%- endblock csv_download_btn -%}

{%- block filter_form_a -%}
  {%- include 'form/q_filter.html.twig' -%}
{%- endblock filter_form_a -%}

{%- block data -%}
  {%- include 'docs/include/docs_list.html.twig' -%}
{%- endblock data -%}