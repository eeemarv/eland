{%- embed 'embed/table.html.twig' -%}
  {%- import 'macro/lbl.html.twig' as lbl -%}
  {%- block controllers -%}
    datatable
  {%- endblock controllers -%}
  {%- block controllers_attr -%}
    data-datatable-sortable-value="true"
  {%- endblock controllers_attr -%}
  {%- block id -%}
    docs-table
  {%- endblock id -%}
  {%- block thead -%}
    <th data-priority="1">
      {{- 'label.name'|trans -}}
    </th>
    <th data-priority="5" data-type="num">
      {{- 'label.time'|trans -}}
    </th>
    {%- if show_access -%}
      <th data-priority="5">
        {{- 'access.visible_for'|trans -}}
      </th>
    {%- endif -%}
    {%- if pp_has_role('admin') -%}
      <th data-priority="10" data-orderable="false">
        &nbsp;
      </th>
    {%- endif -%}
  {%- endblock thead -%}
  {%- block tbody -%}
    {%- for d in docs -%}
      <tr>
        <td>
          {{- d.name|s3(d.filename)|raw -}}
        </td>
        <td data-order="{{- d.created_at|date('U') -}}">
          {{- d.created_at|date_format('min') -}}
        </td>
        {%- if show_access -%}
          <td>
            {{- lbl.btn(d.access) -}}
          </td>
        {%- endif -%}
        {%- if pp_has_role('admin') -%}
          <td>
            {%- include 'include/btn/edit.html.twig' with {
              'btn_route': 'docs_edit',
              'id': d.id
            } -%}
            {%- include 'include/btn/del.html.twig' with {
              'btn_route': 'docs_del',
              'id': d.id
            } -%}
          </td>
        {%- endif -%}
      </tr>
    {%- endfor -%}
  {%- endblock tbody -%}
{%- endembed -%}