<li class="list-group-item{%- if block('class') %} {% block class %}{% endblock %}{%- endif %}">
  {%- block item -%}
  <div class="d-flex">
    <div>
      {%- block div_left -%}
        <dl class="mb-1">
          {%- block dl -%}
          {%- endblock dl -%}
        </dl>
      {%- endblock div_left -%}
    </div>
    <div class="ms-3">
      {%- block div_right -%}
      {%- endblock div_right -%}
    </div>
  </div>
  {%- endblock item -%}
</li>