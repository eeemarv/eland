{%- extends 'base/schema_7.html.twig' -%}

{%- block form -%}
  {%- if form is defined -%}
    <div class="panel panel-info">
      {%- block form_header -%}{%- endblock -%}
      <div class="panel-heading">
        {%- block form_disabled_cms_edit_notice -%}
          {%- if form.vars is defined and form.vars.disabled and {}|pp.edit is defined -%}
            <p class="text-danger">
              {{- 'cms_edit.form_disabled'|trans -}}
            </p>
          {%- endif -%}
        {%- endblock form_disabled_cms_edit_notice -%}
        {%- block form_start -%}
          {{- form_start(form, {'attr': {'novalidate': 'novalidate'}}) -}}
          {{- form_errors(form) -}}
        {%- endblock form_start -%}
        {%- block form_content -%}
          {%- block form_a -%}{{- form_a|default('') -}}{%- endblock -%}
          {%- block form_b -%}{{- form_b|default('') -}}{%- endblock -%}
          {%- block form_c -%}{{- form_c|default('') -}}{%- endblock -%}
          {%- block form_d -%}{{- form_d|default('') -}}{%- endblock -%}
          {%- block form_log_comment -%}
            {%- include 'form/log_comment.html.twig' -%}
          {%- endblock form_log_comment -%}
          {%- block form_cancel_btn -%}
            {%- include 'form/cancel_btn.html.twig' -%}
          {%- endblock form_cancel_btn -%}
          {%- block form_submit_btn -%}
            {%- include 'form/submit_edit_btn.html.twig' -%}
          {%- endblock form_submit_btn -%}
        {%- endblock form_content -%}
        {%- block form_end -%}
          {{- form_end(form) -}}
        {%- endblock form_end -%}
      </div>
      {%- block form_footer -%}{%- endblock -%}
    </div>
  {%- endif -%}
{%- endblock form -%}