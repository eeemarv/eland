{%- extends 'base/base.html.twig' -%}

{%- set schema = pp_schema() -%}

{%- block assets_add -%}
	{{- parent() -}}

	{{- assets_add([
		'typeahead', 'typeahead.js'
	]) -}}

	{%- if {}|pp.edit.en is defined and su_role('admin') and su_is_system_self() -%}
		{{- assets_add([
			'codemirror',
			'summernote',
			'summernote_cms_edit.js'
		]) -}}
	{%- endif -%}
{%- endblock assets_add -%}

{%- block title -%}
	{{- config_str('system.name') -}}
{%- endblock -%}

{%- block body_attr %} class="body-navbar
	{%- if pp_has_role('admin') %} admin
	{%- elseif pp_has_role('guest') %} guest
	{%- endif -%}"
{%- endblock body_attr -%}

{%- block logo -%}
	{%- if config_str('system.logo') -%}
		<a href="{{- block('system_link') -}}" class="navbar-left hidden-xs logo">
			<img src="{{- s3(config_str('system.logo')) -}}" height="50">
		</a>
	{%- endif -%}
{%- endblock logo -%}

{%- block system_link -%}
	{%- if config_str('system.website_url') -%}
		{{- config_str('system.website_url') -}}
	{%- else -%}
		{{- path('home', {}|pp) -}}
	{%- endif -%}
{%- endblock -%}

{%- block page_container -%}
	<div class="swiper-container">
	<div class="row-offcanvas row-offcanvas-left">
	<div id="sidebar" class="sidebar-offcanvas">

	<br>
	<ul class="nav nav-pills nav-stacked">

    {%- if config_bool('messages.enabled')
      and item_visible('guest')
    -%}
    <li{%- if 'messages' == active_menu %} class="active"{%- endif -%}>
      <a href="{{- path('messages'|var_route, {}|pp) -}}">
        <twig:ux:icon name="lucide:newspaper"/>
        &nbsp;
        {{- ('messages.title')|trans({
          'self': 'all_users',
          'with_without_category': 'all_categories'
        }) -}}
      </a>
    </li>
    {%- endif -%}

    {%- if item_visible('guest') -%}
    <li{%- if 'users' == active_menu %} class="active"{%- endif -%}>
      <a href="{{- path('users'|var_route, {}|pp) -}}">
        <twig:ux:icon name="lucide:users"/>
        &nbsp;
        {{- ('users.title')|trans -}}
      </a>
    </li>
    {%- endif -%}

    {%- if config_bool('transactions.enabled')
      and item_visible('guest')
    -%}
    <li{%- if 'transactions' == active_menu %} class="active"{%- endif -%}>
      <a href="{{- path('transactions', {}|pp) -}}">
        <twig:ux:icon name="lucide:arrow-left-right"/>
        &nbsp;
        {{- ('transactions.title')|trans({
          'self': 'all_users',
        }) -}}
      </a>
    </li>
    {%- endif -%}

    {%- if config_bool('news.enabled')
      and item_visible('guest')
    -%}
    <li{%- if 'news' == active_menu %} class="active"{%- endif -%}>
      <a href="{{- path('news'|var_route, {}|pp) -}}">
        <twig:ux:icon name="lucide:calendar-range"/>
        &nbsp;
        {{- ('news.title')|trans -}}
      </a>
    </li>
    {%- endif -%}

    {%- if config_bool('docs.enabled')
      and item_visible('guest')
    -%}
    <li{%- if 'docs' == active_menu %} class="active"{%- endif -%}>
      <a href="{{- path('docs', {}|pp) -}}">
        <twig:ux:icon name="lucide:files"/>
        &nbsp;
        {{- ('docs.title')|trans -}}
      </a>
    </li>
    {%- endif -%}

    {%- if config_bool('forum.enabled')
      and item_visible('guest')
    -%}
    <li{%- if 'forum' == active_menu %} class="active"{%- endif -%}>
      <a href="{{- path('forum', {}|pp) -}}">
        <twig:ux:icon name="lucide:messages-square"/>
        &nbsp;
        {{- ('forum.title')|trans -}}
      </a>
    </li>
    {%- endif -%}

    {%- if config_bool('support_form.enabled')
      and item_visible('user')
    -%}
    <li{%- if 'support_form' == active_menu %} class="active"{%- endif -%}>
      <a href="{{- path('support_form', {}|pp) -}}">
        <twig:ux:icon name="lucide:ambulance"/>
        &nbsp;
        {{- ('support_form.title')|trans -}}
      </a>
    </li>
    {%- endif -%}

    {%- if config_bool('home.menu.enabled')
      and item_visible('anonymous')
    -%}
    <li{%- if 'home' == active_menu %} class="active"{%- endif -%}>
      <a href="{{- path('home', {}|pp) -}}">
        <twig:ux:icon name="lucide:home"/>
        &nbsp;
        {{- ('home.title')|trans -}}
      </a>
    </li>
    {%- endif -%}

    {%- if item_visible('anonymous') -%}
    <li{%- if 'login' == active_menu %} class="active"{%- endif -%}>
      <a href="{{- path('login', {}|pp) -}}">
        <twig:ux:icon name="lucide:log-in"/>
        &nbsp;
        {{- ('login.title')|trans -}}
      </a>
    </li>
    {%- endif -%}

    {%- if config_bool('contact_form.enabled')
      and item_visible('anonymous')
    -%}
    <li{%- if 'contact_form' == active_menu %} class="active"{%- endif -%}>
      <a href="{{- path('contact_form', {}|pp) -}}">
        <twig:ux:icon name="lucide:message-circle-question-mark"/>
        &nbsp;
        {{- ('contact_form.title')|trans -}}
      </a>
    </li>
    {%- endif -%}

    {%- if config_bool('register_form.enabled')
      and item_visible('anonymous')
    -%}
    <li{%- if 'register_form' == active_menu %} class="active"{%- endif -%}>
      <a href="{{- path('register_form', {}|pp) -}}">
        <twig:ux:icon name="lucide:square-check"/>
        &nbsp;
        {{- ('register_form.title')|trans -}}
      </a>
    </li>
    {%- endif -%}

	</ul>

	{%- block content_sidebar-%}
		{%- embed 'embed/static_content.html.twig' with {
			'with_role': true,
			'with_route': true
		} -%}
			{%- block block_name -%}sidebar{%- endblock -%}
		{%- endembed -%}

		{%- embed 'embed/static_content.html.twig' with {
			'with_role': false,
			'with_route': true
		} -%}
			{%- block block_name -%}sidebar{%- endblock -%}
		{%- endembed -%}

		{%- embed 'embed/static_content.html.twig' with {
			'with_role': true,
			'with_route': false
		} -%}
			{%- block block_name -%}sidebar{%- endblock -%}
		{%- endembed -%}
	{%- endblock content_sidebar -%}

	</div>

	<div id="wrap">
	<div id="main" class="container-fluid clear-top{%- if pp_has_role('admin') %} admin{%- endif -%}">

  {%- if pp_has_role('guest') and query_params.welcome is defined -%}
    {%- include 'include/welcome.html.twig' -%}
  {%- endif -%}

	{%- if mollie_checkout_ary is defined -%}
		{%- include 'mollie/checkout/mollie_checkout_ary.html.twig' -%}
	{%- endif -%}

	{%- block alert -%}
		{%- include 'include/alert.html.twig' -%}
	{%- endblock alert -%}

	{%- block cms_edit_form -%}
		{%- include 'include/cms_edit_form.html.twig' -%}
	{%- endblock cms_edit_form -%}

	{%- block cms_edit_extra -%}{%- endblock -%}

	{%- block pre_heading -%}
		{%- embed 'embed/static_content.html.twig' with {
			'with_role': true,
			'with_route': true
		} -%}
			{%- block block_name -%}pre_heading{%- endblock -%}
		{%- endembed -%}

		{%- embed 'embed/static_content.html.twig' with {
			'with_role': false,
			'with_route': true
		} -%}
			{%- block block_name -%}pre_heading{%- endblock -%}
		{%- endembed -%}

		{%- embed 'embed/static_content.html.twig' with {
			'with_role': true,
			'with_route': false
		} -%}
			{%- block block_name -%}pre_heading{%- endblock -%}
		{%- endembed -%}
	{%- endblock pre_heading -%}

  {%- if block('content_controllers') -%}
    <div data-controller="{%- block content_controllers -%}{%- endblock %}"
    {%- if block('content_controllers_attr') %} {% endif -%}
    {%- block content_controllers_attr -%}
    {%- endblock -%}
    >
  {%- endif -%}

	{%- block btn_row -%}
	<div class="row">
		<div class="col-md-12 top-buttons mt-5p">
			<div class="visible-xs pull-left button-offcanvas menu-button">
				<button type="button" class="btn btn-primary btn-lg" data-toggle="offcanvas" title="Menu">
          <twig:ux:icon name="lucide:chevron-left"/>
				</button>
			</div>

			{%- block btn_top_add -%}{%- endblock -%}
			{%- block btn_top_edit -%}{%- endblock -%}
			{%- block btn_top_del -%}{%- endblock -%}
			{%- block btn_top_password_edit -%}{%- endblock -%}
			{%- block btn_top_transaction -%}{%- endblock -%}
			{%- block btn_top_config -%}{%- endblock -%}
			{%- block btn_top_bulk -%}{%- endblock -%}

			{%- if block('btn_nav_top_right') -%}
				<div class="pull-right">
					{%- block btn_nav_top_right -%}
						{%- if pp_has_role('admin')
              and (block('csv_download_btn')
                or block('local_admin_menu'))
            -%}
							<div class="btn-group" role="group">
                {%- block csv_download_btn -%}
                {%- endblock csv_download_btn -%}
								{%- block local_admin_menu -%}
								{%- endblock local_admin_menu -%}
							</div>
						{%- endif -%}
						{%- block btn_show_columns -%}{%- endblock -%}
						{%- block btn_view -%}{%- endblock -%}
						{%- block btn_item_nav -%}{%- endblock -%}
					{%- endblock btn_nav_top_right -%}
				</div>
			{%- endif -%}
		</div>
	</div>
	{%- endblock btn_row -%}

	{%- block heading -%}
		<h1{%- if block('heading_class') %} class="{%- block heading_class -%}{%- endblock -%}"{%- endif -%}>
      {%- if admin_heading is defined -%}
        {%- include 'include/label/admin.html.twig' -%}
        &nbsp;
      {%- endif -%}
      {%- block heading_icon -%}
      {%- endblock heading_icon -%}
      &nbsp;
			{%- block heading_title -%}
				{{- (active_menu ~ '.title')|trans -}}
			{%- endblock heading_title -%}
			{%- block heading_append -%}{%- endblock heading_append -%}
		</h1>
	{%- endblock heading -%}

	{%- block heading_sub -%}{%- endblock -%}

	{%- block content_top -%}
		{%- embed 'embed/static_content.html.twig' with {
			'with_role': true,
			'with_route': true
		} -%}
			{%- block block_name -%}top{%- endblock -%}
		{%- endembed -%}

		{%- embed 'embed/static_content.html.twig' with {
			'with_role': false,
			'with_route': true
		} -%}
			{%- block block_name -%}top{%- endblock -%}
		{%- endembed -%}

		{%- embed 'embed/static_content.html.twig' with {
			'with_role': true,
			'with_route': false
		} -%}
			{%- block block_name -%}top{%- endblock -%}
		{%- endembed -%}
	{%- endblock content_top -%}

	{%- block columns_form -%}
	{%- endblock columns_form -%}

	{%- block help_form -%}
	{%- endblock help_form -%}

	{%- block filter_form -%}
		{%- if filter_form is defined -%}
			<div class="panel panel-info{%- if filter_collapse is defined and filter_collapse %} collapse{%- endif -%}" id="filter">
				{%- block filter_form_header -%}{%- endblock -%}
				<div class="panel-heading">
					{%- block filter_form_start -%}
						{{- form_start(filter_form, {'attr': {'novalidate': 'novalidate'}}) -}}
						{{- form_errors(filter_form) -}}
					{%- endblock filter_form_start -%}
					{%- block filter_form_content -%}
						{%- block filter_form_a -%}{{- filter_form_a|default('') -}}{%- endblock -%}
					{%- endblock filter_form_content -%}
					{%- block filter_form_context -%}
						{%- set hidden_ary = query_params|filter((v, k) => k != 'f' and k != 'uid')|flatten|filter((v, k) => k != 'p[start]') -%}
						{%- for n, v in hidden_ary -%}
							<input name="{{- n -}}" value="{{- v -}}" type="hidden">
						{%- endfor -%}
					{%- endblock filter_form_context -%}
					{%- block filter_form_end -%}
						{{- form_end(filter_form) -}}
					{%- endblock filter_form_end -%}
				</div>
				{%- block filter_form_footer -%}{%- endblock -%}
			</div>
		{%- endif -%}
	{%- endblock filter_form -%}

	{%- block pane_select -%}{%- endblock -%}

	{%- block pagination -%}{%- endblock -%}

	{%- block content -%}
		{{- content|raw -}}
	{%- endblock content -%}

	{%- block data -%}
	{%- endblock data -%}

	{%- block pre_form -%}{%- endblock -%}

	{%- block form -%}
		{%- if form is defined -%}
			<div class="panel panel-info">
				{%- block form_header -%}{%- endblock -%}
				<div class="panel-heading">
					{%- block form_disabled_cms_edit_notice -%}
						{%- if form.vars is defined and form.vars.disabled and {}|pp.edit is defined -%}
							<p class="text-danger">
								{{- 'cms_edit.form_disabled'|trans -}}
							</p>
						{%- endif -%}
					{%- endblock form_disabled_cms_edit_notice -%}
					{%- block form_start -%}
						{{- form_start(form, {'attr': {'novalidate': 'novalidate'}}) -}}
						{{- form_errors(form) -}}
					{%- endblock form_start -%}
					{%- block form_content -%}
						{%- block form_a -%}{{- form_a|default('') -}}{%- endblock -%}
						{%- block form_b -%}{{- form_b|default('') -}}{%- endblock -%}
						{%- block form_c -%}{{- form_c|default('') -}}{%- endblock -%}
            {%- block form_log_comment -%}
							{%- include 'form/log_comment.html.twig' -%}
            {%- endblock form_log_comment -%}
						{%- block form_cancel_btn -%}
							{%- include 'form/cancel_btn.html.twig' -%}
						{%- endblock form_cancel_btn -%}
						{%- block form_submit_btn -%}
							{%- include 'form/submit_edit_btn.html.twig' -%}
						{%- endblock form_submit_btn -%}
					{%- endblock form_content -%}
					{%- block form_end -%}
						{{- form_end(form) -}}
					{%- endblock form_end -%}
				</div>
				{%- block form_footer -%}{%- endblock -%}
			</div>
		{%- endif -%}
	{%- endblock form -%}

	{%- block post_form -%}{%- endblock -%}

	{%- block pagination_bottom -%}
		{{- block('pagination') -}}
	{%- endblock pagination_bottom -%}

	{%- block footnote -%}{%- endblock -%}

	{%- block bulk_actions -%}{%- endblock -%}

  {%- if block('content_controllers') -%}
    </div>
  {%- endif -%}

	{%- block content_bottom -%}
		{%- embed 'embed/static_content.html.twig' with {
			'with_role': true,
			'with_route': true
		} -%}
			{%- block block_name -%}bottom{%- endblock -%}
		{%- endembed -%}

		{%- embed 'embed/static_content.html.twig' with {
			'with_role': false,
			'with_route': true
		} -%}
			{%- block block_name -%}bottom{%- endblock -%}
		{%- endembed -%}
	{%- endblock content_bottom -%}

	{%- embed 'embed/static_content.html.twig' with {
		'with_role': true,
		'with_route': false
	} -%}
		{%- block block_name -%}bottom{%- endblock -%}
	{%- endembed -%}

	</div>
	</div>
	</div>
{%- endblock page_container -%}

{%- block footer_system -%}
	{%- embed 'embed/static_content.html.twig' with {
		'with_role': true,
		'with_route': false
	} -%}
		{%- block block_name -%}footer{%- endblock -%}
	{%- endembed -%}

	{%- if static_content_has(false, false, 'footer') -%}
	<footer class="alert-info">
		<br>
		<div class="container">
			{%- embed 'embed/static_content.html.twig' with {
				'with_role': false,
				'with_route': false
			} -%}
				{%- block block_name -%}footer{%- endblock -%}
			{%- endembed -%}
		</div>
		<br>
	</footer>
	{%- endif -%}
{%- endblock footer_system -%}
