{%- extends 'base/schema_0.html.twig' -%}

{%- block assets_add -%}
	{{- parent() -}}

	{%- if {}|pp.edit.en is defined and su_role_short() == 'a' and su_is_system_self() -%}
		{{- assets_add([
			'codemirror',
			'summernote',
			'summernote_cms_edit.js'
		]) -}}
	{%- endif -%}
{%- endblock assets_add -%}

{%- block page_container -%}
<div data-controller="offcanvas">
  <div class="row-offcanvas"
    data-offcanvas-target="container"
  >
    <div class="offcanvas-backdrop"
      data-action="click->offcanvas#close">
    </div>

    <div class="offcanvas-sidebar">
      {%- include 'include/sidebar_content.html.twig' -%}
    </div>

    <div class="offcanvas-main-wrap">
      <div class="offcanvas-main-content container-fluid clear-top{%- if pp_has_role('admin') %} admin{%- endif -%}"
        data-action="touchstart->offcanvas#touchStart touchend->offcanvas#touchEnd touchmove->offcanvas#touchMove"
      >

      {%- block main_content -%}
      {%- endblock main_content -%}

      </div> {#} main {#}
    </div> {#} wrap {#}
  </div> {#} row-offcanvas {#}
</div> {#} data-controller=offcanvas {#}

{%- endblock page_container -%}

{%- block footer_system -%}
	{%- embed 'embed/static_content.html.twig' with {
		'with_role': true,
		'with_route': false
	} -%}
		{%- block block_name -%}footer{%- endblock -%}
	{%- endembed -%}

	{%- if static_content_has(false, false, 'footer') -%}
	<footer class="alert-info">
		<br>
		<div class="container">
			{%- embed 'embed/static_content.html.twig' with {
				'with_role': false,
				'with_route': false
			} -%}
				{%- block block_name -%}footer{%- endblock -%}
			{%- endembed -%}
		</div>
		<br>
	</footer>
	{%- endif -%}
{%- endblock footer_system -%}