{%- extends 'base/sidebar.html.twig' -%}

{%- block navbar_toggle_button -%}
	<button type="button" class="navbar-toggle collapsed" data-toggle="collapse" data-target="#navbar-collapse-1" aria-expanded="false">
		<span class="sr-only">Toggle navigation</span>
		<span class="icon-bar"></span>
		<span class="icon-bar"></span>
		<span class="icon-bar"></span>
	</button>
{%- endblock navbar_toggle_button -%}

{%- block navbar_collapse -%}
	<div class="collapse navbar-collapse" id="navbar-collapse-1">
	<ul class="nav navbar-nav navbar-right">

	{%- block navbar_menu -%}
		{%- set su_logins_role_short = su_logins_role_short() -%}
		{%- set intersystem_schemas = intersystem_schemas(su_schema()) -%}

		{%- if su_logins_role_short|length > 1 or (intersystem_schemas|length and su_logins_role_short|length) -%}
			{%- embed 'embed/menu_dropdown.html.twig' -%}
        {%- block icon -%}
          <twig:ux:icon name="lucide:share-2"/>
        {%- endblock icon -%}
				{%- block label -%}{{- 'system_menu.system'|trans -}}{%- endblock label -%}
				{%- block menu_items -%}
					<li class="dropdown-header">
						{%- if su_logins_role_short|length == 1 -%}
							{{- 'system_menu.own_system'|trans -}}
						{%- else -%}
							{{- 'system_menu.own_systems'|trans -}}
						{%- endif -%}
					</li>
					{%- for sch, rlshrt in su_logins_role_short -%}
						<li{%- if sch == su_schema() %} class="active{%- if sch != schema -%}-group{%- endif -%}"{%- endif -%}>
							<a href="{{- path(route|fallback_route(sch), {'schema': sch, 'role_short': rlshrt}) -}}">
								{{- config_str('system.name', sch) -}}
							</a>
						</li>
					{%- endfor -%}
					{%- if intersystem_schemas|length -%}
						<li class="dropdown-header">
							{%- if intersystem_schemas|length == 1 -%}
								{{- 'system_menu.linked_intersystem'|trans -}}
							{%- else -%}
								{{- 'system_menu.linked_intersystems'|trans -}}
							{%- endif -%}
						</li>
					{%- endif -%}
					{%- for sch in intersystem_schemas -%}
						<li{%- if sch == schema %} class="active"{%- endif -%}>
							<a href="{{- path(route|fallback_route(sch), {'schema': sch, 'os': su_schema(), 'role_short': 'g', 'welcome': '1'}) -}}">
								{{- config_str('system.name', sch) -}}
							</a>
						</li>
					{%- endfor -%}
				{%- endblock menu_items -%}
			{%- endembed -%}
		{%- endif -%}

		{%- if su_role('user') or su_role('admin') -%}
			{%- if su_is_master() -%}
				{%- set account_name = 'Master' -%}
			{%- else -%}
				{%- set account_name = account(su_id(), su_schema()) -%}
			{%- endif -%}

			{%- if not su_is_system_self() -%}
				{%- set account_name = account_name ~ ' [' ~ config_str('system.name', su_schema()) ~ ']' -%}
			{%- endif -%}

			{%- set su_role_short = su_role('admin') ? 'a' : 'u' -%}

			{%- embed 'embed/menu_dropdown.html.twig' -%}
        {%- block icon -%}
          <twig:ux:icon name="lucide:user"/>
        {%- endblock icon -%}
				{%- block label -%}{{- account_name -}}{%- endblock label -%}
				{%- block menu_items -%}
					{%- set pp_su_role_short = pp_ary().role_short is defined and pp_ary().role_short != 'g' ? pp_ary().role_short : su_role_short -%}
					{%- if su_is_system_self() and not su_is_master() -%}

            <li{%- if 'users_show_self' == route %} class="active"{%- endif -%}>
              <a href="{{- path('users_show_self', {}|pp|merge({'role_short': pp_su_role_short})) -}}">
                <twig:ux:icon name="lucide:user"/>
                &nbsp;
                {{- ('users_show.title')|trans({
                  'self': 'self',
                  'user': '',
                }) -}}
              </a>
            </li>

            {%- if config_bool('messages.enabled') -%}
              <li{%- if 'messages_self'|var_route == route %} class="active"{%- endif -%}>
                <a href="{{- path('messages_self'|var_route, {}|pp|merge({'role_short': pp_su_role_short})) -}}">
                  <twig:ux:icon name="lucide:newspaper"/>
                  &nbsp;
                  {{- 'messages.title'|trans({
                    'self': 'self',
                    'with_without_category': 'all',
                  }) -}}
                </a>
              </li>
            {%- endif -%}

            {%- if config_bool('transactions.enabled') -%}
              <li{%- if 'transactions_self' == route %} class="active"{%- endif -%}>
                <a href="{{- path('transactions_self', {}|pp|merge({'role_short': pp_su_role_short})) -}}">
                  <twig:ux:icon name="lucide:arrow-left-right"/>
                  &nbsp;
                  {{- 'transactions.title'|trans({
                    'self': 'self',
                  }) -}}
                </a>
              </li>
            {%- endif -%}

						<li class="divider"></li>

					{%- endif -%}

					<li>
						<a href="{{- path('logout', su_ary()) -}}">
              <twig:ux:icon name="lucide:log-out"/>
							&nbsp;
							{{- 'logout.title'|trans -}}
						</a>
					</li>
				{%- endblock menu_items -%}
			{%- endembed -%}
		{%- endif -%}

		{%- if su_role('admin') and su_is_system_self() -%}
			{%- embed 'embed/menu_dropdown.html.twig' -%}
				{%- block menu_class %} bg-info{%- endblock menu_class -%}
        {%- block icon -%}
          <twig:ux:icon name="lucide:settings"/>
        {%- endblock icon -%}
				{%- block label -%}
          {{- 'label.admin'|trans -}}
        {%- endblock label -%}
				{%- block menu_items -%}
          <li{%- if pp_has_role('admin') %} class="active-group"{%- endif -%}>
            <a href="{{- path(route, all_params|merge({'role_short': 'a'})) -}}">
              <twig:ux:icon name="lucide:settings"/>
              &nbsp;
              {{- 'modus.admin'|trans -}}
            </a>
          </li>

          <li{%- if pp_has_role('user') %} class="active-group"{%- endif -%}>
            <a href="{{- path(route|fallback_route(schema), all_params|merge({'role_short': 'u'})) -}}">
              <twig:ux:icon name="lucide:user"/>
              &nbsp;
              {{- 'modus.user'|trans -}}
            </a>
          </li>

					{%- if config_bool('intersystem.enabled') -%}
            <li{%- if pp_has_role('guest') %} class="active-group"{%- endif -%}>
              <a href="{{- path(route|fallback_route(schema), all_params|merge({'role_short': 'g'})) -}}">
                <twig:ux:icon name="lucide:share-2"/>
                &nbsp;
                {{- 'modus.guest'|trans -}}
              </a>
            </li>
					{%- endif -%}

					<li class="divider"></li>

					{%- if {}|pp.edit.en is defined -%}
						<li class="active-group">
							<a href="{{- path(route, all_params|merge({'edit': {'en': '0'}})) -}}">
					{%- else -%}
						<li>
							<a href="{{- path(route, all_params|merge({'edit': {'en': '1', 'route': '1', 'inline': '1'}})) -}}">
					{%- endif -%}
                <twig:ux:icon name="lucide:pencil"/>
								&nbsp;
								{{- 'cms_edit.title'|trans -}}
							</a>
						</li>

					<li class="divider"></li>

          <li{%- if active_menu == 'config' %} class="active"{%- endif -%}>
            <a href="{{- path('config_name', {}|pp|merge({'role_short':'a'})) -}}">
              <twig:ux:icon name="lucide:wrench"/>
              &nbsp;
              {{- ('config.title')|trans -}}
            </a>
          </li>

          <li{%- if active_menu == 'export' %} class="active"{%- endif -%}>
            <a href="{{- path('export', {}|pp|merge({'role_short':'a'})) -}}">
              <twig:ux:icon name="lucide:download"/>
              &nbsp;
              {{- ('export.title')|trans -}}
            </a>
          </li>

          <li{%- if active_menu == 'logs' %} class="active"{%- endif -%}>
            <a href="{{- path('logs', {}|pp|merge({'role_short':'a'})) -}}">
              <twig:ux:icon name="lucide:history"/>
              &nbsp;
              {{- ('logs.title')|trans -}}
            </a>
          </li>

				{%- endblock menu_items -%}
			{%- endembed -%}
		{%- endif -%}
	{%- endblock navbar_menu -%}

	</ul>
	</div>
{%- endblock navbar_collapse -%}
