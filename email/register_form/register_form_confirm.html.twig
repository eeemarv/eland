{%- extends '@email/base/base.html.twig' -%}
{%- trans_default_domain 'mail' -%}

{%- block subject -%}
  {{- 'register_form_confirm.subject'|trans -}}
{%- endblock subject %}

{%- block content_1row -%}
  <button href="{{- url('register_form_confirm', {'confirm_token': confirm_token}|mpp) -}}" class="radius">
    {{- 'register_form_confirm.btn_label'|trans -}}
  </button>
  <p>
    {{- 'register_form_confirm.message'|trans -}}
  </p>
  <p>
    {{- 'expiration.1_hour'|trans -}}
  </p>
  <p>
    {{- 'register_form_confirm.explain'|trans({
      'system_name': config_str('system.name'),
      'ao': a_open('register_form', {}|mpp),
      'ac': '</a>'
    })|raw -}}
  </p>
{%- endblock content_1row -%}
