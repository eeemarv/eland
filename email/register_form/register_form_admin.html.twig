{%- extends '@email/base/base.html.twig' -%}
{%- trans_default_domain 'mail' -%}

{%- set subsribed = 'admin' -%}

{% block subject -%}
  {{- 'register_form_admin.subject'|trans({
    'full_name': user_full_name(user_id)
  }) -}}
{%- endblock subject -%}

{%- block content_1row -%}
  <p>
    {{- 'register_form_admin.message'|trans -}}
  </p>
  <p>
    <b>{{- 'label.name'|trans -}}:</b> {{ user_full_name(user_id) -}}<br/>
  </p>
  <button href="{{- url('users_show', {'id': user_id}|mpp('admin')) -}}"  class="radius">
    {{- 'register_form_admin.btn'|trans -}}
  </button>
{%- endblock content_1row -%}

{%- block subscribed -%}
  {%- include '@email/subscribed/admin.html.twig' -%}
{%- endblock subscribed -%}