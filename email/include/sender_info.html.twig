{%- trans_default_domain 'mail' -%}

<row class="el-bl-violet0">
  <columns>
    <h6>
      {{- 'sender_info.title'|trans -}}
    </h6>
    <b>{{- 'sender_info.email'|trans -}}:</b> {{ sender.email|raw }}<br/>
    <b>{{- 'sender_info.ip'|trans -}}:</b> {{ sender.ip|raw }}<br/>
    <b>{{- 'sender_info.agent'|trans -}}:</b> {{ sender.agent|raw }}<br/>
  </columns>
</row>
