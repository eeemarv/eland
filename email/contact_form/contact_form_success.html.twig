{%- extends '@email/base/base.html.twig' -%}
{%- trans_default_domain 'mail' -%}

{% block subject -%}
  {{- 'contact_form_success.subject'|trans -}}
{%- endblock subject -%}

{%- block content_1row -%}
  <p>
    {{- 'contact_form_success.explain'|trans({
      'system_name': config_str('system.name')
    }) -}}
  </p>
{%- endblock content_1row -%}

{%- block message_text -%}
  {{- message|nl2br -}}
{%- endblock message_text -%}
