{%- extends '@email/base/base.html.twig' -%}
{%- trans_default_domain 'mail' -%}

{% block subject -%}
  {{- 'contact_form.subject'|trans -}}
{%- endblock subject -%}

{% block content -%}
  <row>
    <columns>
      <p>
        {{- 'contact_form.explain'|trans({
            'ao': a_open('home', mpp()),
            'ac': '</a>',
            'system_name': config_str('system.name', schema)
        })|raw -}}
      </p>
    </columns>
  </row>

  {%- include '@email/include/message.html.twig' -%}
{%- endblock content -%}

{%- block sender_info_footer -%}
  {%- include '@email/include/sender_info.html.twig' -%}
{%- endblock sender_info_footer -%}
