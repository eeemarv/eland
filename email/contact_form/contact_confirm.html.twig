{%- extends '@email/base/base.html.twig' -%}
{%- trans_default_domain 'mail' -%}

{%- block subject -%}
  {{- 'contact_confirm.subject'|trans({
    'system_name': config_str('system.name', schema)})
  -}}
{%- endblock subject -%}

{%- block header -%}
  {{- 'contact.sub_header'|trans -}}
{%- endblock header -%}

{%- block content -%}
<row>
  <columns>
    <button href="{{- abs_url('contact_form_confirm', mpp()|merge({'token': token})) -}}" class="radius">
      {{- 'contact_confirm.btn_label'|trans -}}
    </button>
    <p>
      {{- 'contact_confirm.html_msg'|trans -}}
    </p>
    <p>
      {{- 'expiration.1_day'|trans -}}
    </p>
    <p>
      {{- 'contact_confirm.explain'|trans({
        'system_name': config_str('system.name', schema),
        'ao': a_open('contact_form', mpp()),
        'ac': '</a>'
      })|raw -}}
    </p>
  </columns>
</row>
{%- endblock content -%}
