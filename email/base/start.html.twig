{%- trans_default_domain 'mail' -%}
{%- apply inky_to_html|inline_css(source('@public' ~ asset('styles/email.scss'))) -%}

{%- set email_background = schema is defined ? config_str('mail.style.background') : 'blue' -%}

<wrapper class="b-{{- email_background -}}-0">
  <container>
    {%- include '@email/base/include/no_reply.html.twig' -%}

    {%- block header_container -%}
      {%- if schema is defined or block('header') is not empty -%}
        <row>
          <columns>
            <spacer size="10"></spacer>
            <p class="text-center">
              {%- if schema is defined -%}
                {{- config_str('system.name') -}}
              {%- else -%}
                {%- block header -%}{%- endblock -%}
              {%- endif -%}
            </p>
            {%- include '@email/include/h_bar.html.twig' -%}
            <spacer size="4"></spacer>
          </columns>
        </row>
      {%- endif -%}
    {%- endblock header_container -%}

    {%- if block('content_1row') is not empty -%}
      <row>
        <columns>
          {% block content_1row -%}
          {%- endblock -%}
        </columns>
      </row>
    {%- endif -%}

    {%- if block('message_text') is not empty -%}
      <row class="l-{{- email_background -}}-3 b-{{- email_background -}}-8">
        <columns>
          <spacer size="8"></spacer>
          <p>
            {%- block message_text -%}
            {%- endblock -%}
          </p>
        </columns>
      </row>
      <spacer size="16"></spacer>
    {%- endif -%}

    {%- block content -%}
    {%- endblock -%}

    {%- block sender_info_footer -%}
    {%- endblock -%}

    {%- block account_info_footer -%}
    {%- endblock -%}

    {%- if block('subscribed') is not empty -%}
      <row>
        <columns>
          {%- include '@email/include/h_bar.html.twig' -%}
          <spacer size="8"></spacer>
          <p>
            {%- block subscribed -%}
            {%- endblock -%}
          </p>
        </columns>
      </row>
    {%- endif -%}

    {%- if schema is defined -%}
      {%- include '@email/base/include/system_footer.html.twig' -%}
    {%- endif -%}

    {%- include '@email/base/include/eland_footer.html.twig' -%}
  </container>
</wrapper>

{%- endapply -%}
