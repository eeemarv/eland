{%- extends '@email/base/base.html.twig' -%}
{%- trans_default_domain 'mail' -%}

{% block subject -%}
  {{- 'support_form.subject'|trans -}}
{%- endblock subject -%}

{% block content_1row -%}
  <p>
    {{- 'support_form.explain'|trans({
      'ao': a_open('home', {}|mpp),
      'ac': '</a>',
      'system_name': config_str('system.name'),
      'account':  a_open('users_show', {'id': user_id}|mpp('admin')
        ~ account(user_id)
        ~ '</a>'
    })|raw -}}
  </p>
  <p>
    {%- if can_reply -%}
      {{- 'support_form.explain_reply'|trans -}}
    {%- else -%}
      {{- 'support_form.explain_no_reply'|trans({
        'ao': a_open('users_show', {'id': user_id}|mpp('admin')),
        'ac': '</a>'
      })|raw -}}
    {%- endif -%}
  </p>
{%- endblock content_1row -%}

{%- block message_text -%}
  {{- message|nl2br -}}
{%- endblock message_text -%}

{%- block subscribe -%}
  support
{%- endblock subscribe -%}
