<row {%- if block('row_class') is not_empty %} class="{%- block row_class -%}{%- endblock -%}"{%- endif -%}>
  <columns>
    {%- block column -%}
      <p {%- if block('p_class') is not_empty %} class="{%- block p_class -%}{%- endblock -%}"{%- endif -%}>
        {%- block p -%}{%- endblock -%}
      </p>
    {%- endblock column -%}
  </columns>
  {%- if block('second_column') is not empty -%}
    <column>
      {%- block second_column -%}{%- endblock -%}
    </column>
  {%- endif -%}
</row>