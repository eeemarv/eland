    <br/>
    {{- 'label.to'|trans -}}: <b>{{- to_code }} {{ to_name }}</b>
    <br>
    {{- a_open('transactions_show', {}|mpp(id: id, d_role:true))|raw -}}
    {{- 'transactions.link'|trans -}}
