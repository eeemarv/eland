{%- extends '@email/base/base.html.twig' -%}
{%- trans_default_domain 'mail' -%}

{% block subject_line -%}
  {{- 'password_reset_success.subject'|trans|raw -}}
{%- endblock %}

{%- block html_content -%}
  <row>
    <columns>
      <p>
        {{- 'password_reset_success.message'|trans -}}
      </p>
      <table class="b-{{- email_background -}}-8" border="1" cellpadding="0" cellspacing="0" width="100%">
        <tr>
          <td width="200" style="padding-left: 10px">
            {{- 'label.password'|trans -}}
          </td>
          <td style="font-style: bold; padding-left: 10px">
            {{- password -}}
          </td>
        </tr>
      </table>
    </columns>
  </row>
{%- endblock html_content -%}
