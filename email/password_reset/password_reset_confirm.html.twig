{%- extends '@email/base/base.html.twig' -%}
{%- trans_default_domain 'mail' -%}

{%- block subject -%}
  {{- 'password_reset_confirm.subject'|trans -}}
{%- endblock subject -%}

{%- block content_1row -%}
  <button href="{{- url('password_reset_confirm', {'confirm_token': confirm_token}|mpp) -}}" class="radius">
    {{- 'password_reset_confirm.btn_label'|trans -}}
  </button>
  <p>
    {{- 'password_reset_confirm.message'|trans({
        'system_name': config_str('system.name'),
    }) -}}
  </p>
  <p>
    {{- 'expiration.1_hour'|trans -}}
  </p>
  <p>
    {{- 'password_reset_confirm.explain'|trans({
      'system_name': config_str('system.name'),
      'ao': a_open('home', {}|mpp),
      'ac': '</a>'
    })|raw -}}
  </p>
{%- endblock content_1row -%}
